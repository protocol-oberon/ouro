;; aat/price-type: the price types Linked Art's examples use, each a Type, to classify a
;; MonetaryAmount. Generated by scripts/aat/generate.pl from scripts/aat/examples.tsv:
;; regenerate it, never edit it.
(import std/base)

(export starting-price
        estimated-price)

(define/constant starting-price  (doc "The MonetaryAmount is the price an auction of a lot starts at. From Linked Art's examples, not its recommended list.") (base/aat "300417242" "Starting Price"))
(define/constant estimated-price (doc "The MonetaryAmount is an estimate of a lot's price. From Linked Art's examples, not its recommended list.") (base/aat "300417244" "Estimated Price"))
