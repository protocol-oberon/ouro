;; aat/technique: the techniques Linked Art's examples use, each a Type, for the technique of
;; an Activity. Generated by scripts/aat/generate.pl from scripts/aat/examples.tsv: regenerate
;; it, never edit it.
(import std/base)

(export cleaning
        painting-technique
        sculpting
        hand-weaving)

(define/constant cleaning           (doc "The technique of cleaning, as in conservation. From Linked Art's examples, not its recommended list.") (base/aat "300053027" "Cleaning"))
(define/constant painting-technique (doc "The technique of painting. From Linked Art's examples, not its recommended list.") (base/aat "300054216" "Painting Technique"))
(define/constant sculpting          (doc "The technique of sculpting. From Linked Art's examples, not its recommended list.") (base/aat "300264383" "Sculpting"))
(define/constant hand-weaving       (doc "The technique of weaving by hand. From Linked Art's examples, not its recommended list.") (base/aat "300053643" "hand weaving"))
