;; aat/currency/iso: the currencies of aat/currency, each with its ISO 4217 code as its
;; notation, as Linked Art's examples mostly write a currency. The codes are ISO 4217's three
;; letters. Generated by scripts/aat/generate.pl from scripts/aat/recommended.tsv: regenerate
;; it, never edit it.
(import aat/currency)

(export british-pounds
        canadian-dollar
        euros
        japanese-yen
        swiss-franc
        us-dollars)

(define/constant british-pounds  (doc "British Pounds, a currency, written GBP.") (with currency/british-pounds :notation "GBP"))
(define/constant canadian-dollar (doc "Canadian Dollars, a currency, written CAD.") (with currency/canadian-dollar :notation "CAD"))
(define/constant euros           (doc "Euros, a currency, written EUR.") (with currency/euros :notation "EUR"))
(define/constant japanese-yen    (doc "Japanese Yen, a currency, written JPY.") (with currency/japanese-yen :notation "JPY"))
(define/constant swiss-franc     (doc "Swiss Francs, a currency, written CHF.") (with currency/swiss-franc :notation "CHF"))
(define/constant us-dollars      (doc "US Dollars, a currency, written USD.") (with currency/us-dollars :notation "USD"))
