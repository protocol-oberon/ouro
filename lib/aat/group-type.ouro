;; aat/group-type: the group types Linked Art recommends, from
;; linked.art/model/vocab/recommended, and those its examples use, each a Type, to classify a
;; Group. Generated by scripts/aat/generate.pl from scripts/aat/recommended.tsv and
;; scripts/aat/examples.tsv: regenerate it, never edit it.
(import std/base)

(export company
        department
        family
        museum
        organization
        society
        studio
        auction-house)

(define/constant company       (doc "The Group is a commercial company or business.") (base/aat "300160084" "Company"))
(define/constant department    (doc "The Group is a department of another organization.") (base/aat "300263534" "Department"))
(define/constant family        (doc "The Group is an (extended) family related by blood and/or marriage.") (base/aat "300055474" "Family"))
(define/constant museum        (doc "The Group is a museum.") (base/aat "300312281" "Museum"))
(define/constant organization  (doc "The Group is an organization or society of some sort.") (base/aat "300025948" "Organization"))
(define/constant society       (doc "The Group is a society of people with a shared interest. From Linked Art's examples, not its recommended list.") (base/aat "300026009" "Society"))
(define/constant studio        (doc "The Group is an artist's studio, its assistants working with the artist. From Linked Art's examples, not its recommended list.") (base/aat "300404275" "Studio"))
(define/constant auction-house (doc "The Group is an auction house. From Linked Art's examples, not its recommended list.") (base/aat "300417515" "Auction House (organization)"))
