;; aat/activity-type: the activity types Linked Art's examples use, each a Type, to classify an
;; Activity. Generated by scripts/aat/generate.pl from scripts/aat/examples.tsv: regenerate it,
;; never edit it.
(import std/base)

(export auction-event
        auction-of-lot
        exhibiting-in-multiple-locations
        conservation-activity
        curating)

(define/constant auction-event                    (doc "The Activity is an auction, of a set of lots. From Linked Art's examples, not its recommended list.") (base/aat "300054751" "Auction Event"))
(define/constant auction-of-lot                   (doc "The Activity is the auction of one lot, part of an auction event. From Linked Art's examples, not its recommended list.") (base/aat "300420001" "Auction of Lot"))
(define/constant exhibiting-in-multiple-locations (doc "The Activity is an exhibition over all its venues. From Linked Art's examples, not its recommended list.") (base/aat "300054773" "Exhibiting in multiple locations"))
(define/constant conservation-activity            (doc "The Activity is the conservation of an object. From Linked Art's examples, not its recommended list.") (base/aat "300404519" "Conservation Activity"))
(define/constant curating                         (doc "The Activity is the curating of a collection. From Linked Art's examples, not its recommended list.") (base/aat "300054277" "Curating"))
