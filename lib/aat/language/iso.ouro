;; aat/language/iso: the languages of aat/language, each with its ISO 639 code as its notation,
;; as Linked Art's examples mostly write a language. The codes are ISO 639-1's two letters;
;; Ancient Greek has none, so it has ISO 639-3's grc. Generated by scripts/aat/generate.pl from
;; scripts/aat/recommended.tsv: regenerate it, never edit it.
(import aat/language)

(export ancient-greek
        arabic
        chinese
        danish
        dutch
        english
        farsi
        finnish
        french
        german
        greek
        hebrew
        hindi
        icelandic
        irish
        italian
        japanese
        korean
        latin
        norwegian
        polish
        portuguese
        romanian
        russian
        spanish
        swedish
        tamil
        thai
        turkish
        urdu
        welsh)

(define/constant ancient-greek (doc "Ancient Greek, a language, written grc.") (with language/ancient-greek :notation "grc"))
(define/constant arabic        (doc "Arabic, a language, written ar.") (with language/arabic :notation "ar"))
(define/constant chinese       (doc "Chinese, a language, written zh.") (with language/chinese :notation "zh"))
(define/constant danish        (doc "Danish, a language, written da.") (with language/danish :notation "da"))
(define/constant dutch         (doc "Dutch, a language, written nl.") (with language/dutch :notation "nl"))
(define/constant english       (doc "English, a language, written en.") (with language/english :notation "en"))
(define/constant farsi         (doc "Farsi, a language, written fa.") (with language/farsi :notation "fa"))
(define/constant finnish       (doc "Finnish, a language, written fi.") (with language/finnish :notation "fi"))
(define/constant french        (doc "French, a language, written fr.") (with language/french :notation "fr"))
(define/constant german        (doc "German, a language, written de.") (with language/german :notation "de"))
(define/constant greek         (doc "Greek, a language, written el.") (with language/greek :notation "el"))
(define/constant hebrew        (doc "Hebrew, a language, written he.") (with language/hebrew :notation "he"))
(define/constant hindi         (doc "Hindi, a language, written hi.") (with language/hindi :notation "hi"))
(define/constant icelandic     (doc "Icelandic, a language, written is.") (with language/icelandic :notation "is"))
(define/constant irish         (doc "Irish, a language, written ga.") (with language/irish :notation "ga"))
(define/constant italian       (doc "Italian, a language, written it.") (with language/italian :notation "it"))
(define/constant japanese      (doc "Japanese, a language, written ja.") (with language/japanese :notation "ja"))
(define/constant korean        (doc "Korean, a language, written ko.") (with language/korean :notation "ko"))
(define/constant latin         (doc "Latin, a language, written la.") (with language/latin :notation "la"))
(define/constant norwegian     (doc "Norwegian, a language, written no.") (with language/norwegian :notation "no"))
(define/constant polish        (doc "Polish, a language, written pl.") (with language/polish :notation "pl"))
(define/constant portuguese    (doc "Portuguese, a language, written pt.") (with language/portuguese :notation "pt"))
(define/constant romanian      (doc "Romanian, a language, written ro.") (with language/romanian :notation "ro"))
(define/constant russian       (doc "Russian, a language, written ru.") (with language/russian :notation "ru"))
(define/constant spanish       (doc "Spanish, a language, written es.") (with language/spanish :notation "es"))
(define/constant swedish       (doc "Swedish, a language, written sv.") (with language/swedish :notation "sv"))
(define/constant tamil         (doc "Tamil, a language, written ta.") (with language/tamil :notation "ta"))
(define/constant thai          (doc "Thai, a language, written th.") (with language/thai :notation "th"))
(define/constant turkish       (doc "Turkish, a language, written tr.") (with language/turkish :notation "tr"))
(define/constant urdu          (doc "Urdu, a language, written ur.") (with language/urdu :notation "ur"))
(define/constant welsh         (doc "Welsh, a language, written cy.") (with language/welsh :notation "cy"))
