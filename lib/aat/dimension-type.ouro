(import std/base)

(export depth
        height
        unknown-physical-dimension
        weight
        width)

(defn depth                      () (doc "The Dimension measures the depth of the entity, from the front to the back.") (base/aat "300072633" "Depth"))
(defn height                     () (doc "The Dimension measures the height of the entity, from the top to the bottom.") (base/aat "300055644" "Height"))
(defn unknown-physical-dimension () (doc "The Dimension measures some unknown physical dimension of the entity.") (base/aat "300055642" "Unknown Physical Dimension"))
(defn weight                     () (doc "The Dimension measures the weight of the entity.") (base/aat "300056240" "Weight"))
(defn width                      () (doc "The Dimension measures the width of the object, from left to right.") (base/aat "300055647" "Width"))
