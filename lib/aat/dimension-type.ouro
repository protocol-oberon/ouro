;; aat/dimension-type: the dimension types Linked Art recommends, from
;; linked.art/model/vocab/recommended, and those its examples use, each a Type, to classify a
;; Dimension. Generated by scripts/aat/generate.pl from scripts/aat/recommended.tsv and
;; scripts/aat/examples.tsv: regenerate it, never edit it.
(import std/base)

(export depth
        height
        unknown-physical-dimension
        weight
        width
        file-size)

(define/constant depth                      (doc "The Dimension measures the depth of the entity, from the front to the back.") (base/aat "300072633" "Depth"))
(define/constant height                     (doc "The Dimension measures the height of the entity, from the top to the bottom.") (base/aat "300055644" "Height"))
(define/constant unknown-physical-dimension (doc "The Dimension measures some unknown physical dimension of the entity.") (base/aat "300055642" "Unknown Physical Dimension"))
(define/constant weight                     (doc "The Dimension measures the weight of the entity.") (base/aat "300056240" "Weight"))
(define/constant width                      (doc "The Dimension measures the width of the object, from left to right.") (base/aat "300055647" "Width"))
(define/constant file-size                  (doc "The Dimension measures the size of a digital file. From Linked Art's examples, not its recommended list.") (base/aat "300265863" "File Size"))
