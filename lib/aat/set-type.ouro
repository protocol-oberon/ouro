;; aat/set-type: the set types Linked Art recommends, from linked.art/model/vocab/recommended,
;; and those its examples use, each a Type, to classify a Set. Generated by
;; scripts/aat/generate.pl from scripts/aat/recommended.tsv and scripts/aat/examples.tsv:
;; regenerate it, never edit it.
(import std/base)

(export archive
        archival-grouping
        archival-sub-grouping
        collection
        auction-lot)

(define/constant archive               (doc "The Set is a top level Archive.") (base/aat "300375748" "Archive"))
(define/constant archival-grouping     (doc "The Set is some grouping within an archive.") (base/aat "300404022" "Archival Grouping"))
(define/constant archival-sub-grouping (doc "The Set is some grouping within an archival grouping.") (base/aat "300404023" "Archival Sub-Grouping"))
(define/constant collection            (doc "The Set is a collection of things, typically physical objects and managed by an organization.") (base/aat "300025976" "Collection"))
(define/constant auction-lot           (doc "The Set is a lot of objects in an auction. From Linked Art's examples, not its recommended list.") (base/aat "300411307" "Auction Lot"))
