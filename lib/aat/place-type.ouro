;; aat/place-type: the place types Linked Art recommends, from
;; linked.art/model/vocab/recommended, and those its examples use, each a Type, to classify a
;; Place. Generated by scripts/aat/generate.pl from scripts/aat/recommended.tsv and
;; scripts/aat/examples.tsv: regenerate it, never edit it.
(import std/base)

(export continent
        country
        state
        province
        county
        city
        museum
        gallery
        auction-house)

(define/constant continent     (doc "The Place is a continent (Europe, Asia, North America, etc).") (base/aat "300128176" "Continent"))
(define/constant country       (doc "The Place is a country or Nation (France, Japan, USA, etc).") (base/aat "300128207" "Country"))
(define/constant state         (doc "The Place is a state (New York, California, etc).") (base/aat "300000776" "State"))
(define/constant province      (doc "The Place is a province or similar region (Ontario, Yorkshire, etc).") (base/aat "300000774" "Province"))
(define/constant county        (doc "The Place is a county (New Haven county, etc).") (base/aat "300000771" "County"))
(define/constant city          (doc "The Place is a city (Paris, Chicago, Tokyo, etc).") (base/aat "300008389" "City"))
(define/constant museum        (doc "The Place is a museum location.") (base/aat "300005768" "Museum (as Place)"))
(define/constant gallery       (doc "The Place is a (museum) gallery room in which art is displayed.") (base/aat "300240057" "Gallery"))
(define/constant auction-house (doc "The Place is an auction house's location. From Linked Art's examples, not its recommended list.") (base/aat "300005234" "Auction House (place)"))
