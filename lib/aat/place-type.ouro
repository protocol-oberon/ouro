;; aat/place-type: the place types Linked Art recommends, from
;; linked.art/model/vocab/recommended, each a Type, to classify a Place. Generated by
;; scripts/aat/generate.pl from scripts/aat/recommended.tsv: regenerate it, never edit it.
(import std/base)

(export continent
        country
        state
        province
        county
        city
        museum
        gallery)

(defn continent () (doc "The Place is a continent (Europe, Asia, North America, etc).") (base/aat "300128176" "Continent"))
(defn country   () (doc "The Place is a country or Nation (France, Japan, USA, etc).") (base/aat "300128207" "Country"))
(defn state     () (doc "The Place is a state (New York, California, etc).") (base/aat "300000776" "State"))
(defn province  () (doc "The Place is a province or similar region (Ontario, Yorkshire, etc).") (base/aat "300000774" "Province"))
(defn county    () (doc "The Place is a county (New Haven county, etc).") (base/aat "300000771" "County"))
(defn city      () (doc "The Place is a city (Paris, Chicago, Tokyo, etc).") (base/aat "300008389" "City"))
(defn museum    () (doc "The Place is a museum location.") (base/aat "300005768" "Museum (as Place)"))
(defn gallery   () (doc "The Place is a (museum) gallery room in which art is displayed.") (base/aat "300240057" "Gallery"))
