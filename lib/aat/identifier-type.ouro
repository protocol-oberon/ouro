;; aat/identifier-type: the identifier types Linked Art recommends, from
;; linked.art/model/vocab/recommended, each a Type, to classify an Identifier. Generated by
;; scripts/aat/generate.pl from scripts/aat/recommended.tsv: regenerate it, never edit it.
(import std/base)

(export accession-number
        local-number
        system-number
        call-number)

(defn accession-number () (doc "An accession number for the object.") (base/aat "300312355" "Accession Number"))
(defn local-number     () (doc "An identifier assigned by the institution but not an accession or system number.") (base/aat "300404621" "Local Number"))
(defn system-number    () (doc "An identifier assigned by an automated system, such as a collection management system.") (base/aat "300435704" "System Number"))
(defn call-number      () (doc "An identifier for where the object is physically in the repository, typically used in libraries.") (base/aat "300311706" "Call Number"))
