;; aat/part-type: the part types Linked Art's examples use, each classified as Part Type, for a
;; part of an object. Generated by scripts/aat/generate.pl from scripts/aat/examples.tsv:
;; regenerate it, never edit it.
(import std/object)

(export support
        back-part)

(define/constant support   (doc "The part is the support of a work, as a painting's canvas. From Linked Art's examples, not its recommended list.") (object/part-type "300014844" "Support"))
(define/constant back-part (doc "The part is the back of a work. From Linked Art's examples, not its recommended list.") (object/part-type "300190692" "Back Part"))
