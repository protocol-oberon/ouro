;; aat/style: the styles Linked Art's examples use, each classified as Style, as Linked Art
;; requires. Generated by scripts/aat/generate.pl from scripts/aat/examples.tsv: regenerate it,
;; never edit it.
(import std/base)

(export cubist
        baroque
        impressionism)

(define/constant cubist        (doc "The style of Cubism. From Linked Art's examples, not its recommended list.") (base/style "300021495" "Cubist"))
(define/constant baroque       (doc "The style of the Baroque. From Linked Art's examples, not its recommended list.") (base/style "300021147" "Baroque"))
(define/constant impressionism (doc "The style of Impressionism. From Linked Art's examples, not its recommended list.") (base/style "300021503" "Impressionism"))
