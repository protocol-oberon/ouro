;; aat/statement-type: the statement types Linked Art recommends, from
;; linked.art/model/vocab/recommended, each a kind of statement, classified as Brief Text, as
;; Linked Art requires. Generated by scripts/aat/generate.pl from scripts/aat/recommended.tsv:
;; regenerate it, never edit it.
(import std/base)

(export note
        description
        access-statement
        bibliography-statement
        condition-statement
        credit-line
        dimensions-statement
        exhibition-statement
        inscription-statement
        markings-statement
        materials-statement
        production-statement
        provenance-statement
        rights-statement
        signature-statement
        summary)

(defn note                   () (doc "A general note about the entity.") (base/statement-kind "300027200" "Note"))
(defn description            () (doc "A description of the entity.") (base/statement-kind "300435416" "Description"))
(defn access-statement       () (doc "A statement about how to get access to the entity.") (base/statement-kind "300133046" "Access Statement"))
(defn bibliography-statement () (doc "A list of citations of the entity, typically in a consistent format.") (base/statement-kind "300026497" "Bibliography Statement"))
(defn condition-statement    () (doc "A description of the physical condition of the object.") (base/statement-kind "300435425" "Condition Statement"))
(defn credit-line            () (doc "A short statement of who should be acknowledged for the object.") (base/statement-kind "300026687" "Credit Line"))
(defn dimensions-statement   () (doc "A description of the dimensions of the object.") (base/statement-kind "300435430" "Dimensions Statement"))
(defn exhibition-statement   () (doc "A statement or citation list about exhibitions that the object has been in.") (base/statement-kind "300435424" "Exhibition Statement"))
(defn inscription-statement  () (doc "A description of inscriptions on the object.") (base/statement-kind "300435414" "Inscription Statement"))
(defn markings-statement     () (doc "A description of non-inscription markings on the object.") (base/statement-kind "300435420" "Markings Statement"))
(defn materials-statement    () (doc "A description or list of the materials the object is made of.") (base/statement-kind "300435429" "Materials Statement"))
(defn production-statement   () (doc "A description of the production or creation of the object.") (base/statement-kind "300435436" "Production Statement"))
(defn provenance-statement   () (doc "A description or semi-structured value describing the ownership history of the object.") (base/statement-kind "300435438" "Provenance Statement"))
(defn rights-statement       () (doc "A description of copyright or other licenses pertaining to the object.") (base/statement-kind "300435434" "Rights Statement"))
(defn signature-statement    () (doc "A description of the artist's signature which is on the object, often part of the artwork.") (base/statement-kind "300028705" "Signature Statement"))
(defn summary                () (doc "A summary of the intellectual content of the object, as opposed to a Description of the object as a whole.") (base/statement-kind "300026032" "Summary"))
