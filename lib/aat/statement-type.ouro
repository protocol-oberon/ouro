;; aat/statement-type: the statement types Linked Art recommends, from
;; linked.art/model/vocab/recommended, and those its examples use, each a kind of statement,
;; classified as Brief Text, as Linked Art requires. Generated by scripts/aat/generate.pl from
;; scripts/aat/recommended.tsv and scripts/aat/examples.tsv: regenerate it, never edit it.
(import std/base)

(export note
        description
        access-statement
        bibliography-statement
        condition-statement
        credit-line
        dimensions-statement
        exhibition-statement
        inscription-statement
        markings-statement
        materials-statement
        production-statement
        provenance-statement
        rights-statement
        signature-statement
        summary
        biography-statement
        abstract
        pagination-statement
        physical-statement)

(define/constant note                   (doc "A general note about the entity.") (base/statement-kind "300027200" "Note"))
(define/constant description            (doc "A description of the entity.") (base/statement-kind "300435416" "Description"))
(define/constant access-statement       (doc "A statement about how to get access to the entity.") (base/statement-kind "300133046" "Access Statement"))
(define/constant bibliography-statement (doc "A list of citations of the entity, typically in a consistent format.") (base/statement-kind "300026497" "Bibliography Statement"))
(define/constant condition-statement    (doc "A description of the physical condition of the object.") (base/statement-kind "300435425" "Condition Statement"))
(define/constant credit-line            (doc "A short statement of who should be acknowledged for the object.") (base/statement-kind "300026687" "Credit Line"))
(define/constant dimensions-statement   (doc "A description of the dimensions of the object.") (base/statement-kind "300435430" "Dimensions Statement"))
(define/constant exhibition-statement   (doc "A statement or citation list about exhibitions that the object has been in.") (base/statement-kind "300435424" "Exhibition Statement"))
(define/constant inscription-statement  (doc "A description of inscriptions on the object.") (base/statement-kind "300435414" "Inscription Statement"))
(define/constant markings-statement     (doc "A description of non-inscription markings on the object.") (base/statement-kind "300435420" "Markings Statement"))
(define/constant materials-statement    (doc "A description or list of the materials the object is made of.") (base/statement-kind "300435429" "Materials Statement"))
(define/constant production-statement   (doc "A description of the production or creation of the object.") (base/statement-kind "300435436" "Production Statement"))
(define/constant provenance-statement   (doc "A description or semi-structured value describing the ownership history of the object.") (base/statement-kind "300435438" "Provenance Statement"))
(define/constant rights-statement       (doc "A description of copyright or other licenses pertaining to the object.") (base/statement-kind "300435434" "Rights Statement"))
(define/constant signature-statement    (doc "A description of the artist's signature which is on the object, often part of the artwork.") (base/statement-kind "300028705" "Signature Statement"))
(define/constant summary                (doc "A summary of the intellectual content of the object, as opposed to a Description of the object as a whole.") (base/statement-kind "300026032" "Summary"))
(define/constant biography-statement    (doc "A statement about the life or history of a person or group. From Linked Art's examples, not its recommended list.") (base/statement-kind "300435422" "Biography Statement"))
(define/constant abstract               (doc "A brief summary of the content of a work. From Linked Art's examples, not its recommended list.") (base/statement-kind "300026032" "Abstract"))
(define/constant pagination-statement   (doc "A statement of the pages a work runs over. From Linked Art's examples, not its recommended list.") (base/statement-kind "300435440" "Pagination Statement"))
(define/constant physical-statement     (doc "A statement of the physical extent of a work, as its pages and illustrations. From Linked Art's examples, not its recommended list.") (base/statement-kind "300435452" "Physical Statement"))
