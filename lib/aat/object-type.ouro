;; regenerate it, never edit it.
(import std/base)

(export architecture
        armor
        book
        clothing
        coin
        decorative-arts
        drawing
        frame
        furniture
        jewelry
        lithograph
        manuscript
        map-object
        miniature
        mosaic
        musical-instrument
        painting
        photograph
        print
        sculpture
        stained-glass
        tapestry)

(defn architecture       () (doc "Structure or part of a structure which is the result of conscious construction.") (base/work-type "300263552" "Architecture"))
(defn armor              () (doc "Clothing designed to protect the body in combat.") (base/work-type "300036745" "Armor"))
(defn book               () (doc "Object comprised of a sequence of leaves of paper or other material, typically carrying language or image, and bound together into a codex.") (base/work-type "300028051" "Book"))
(defn clothing           () (doc "Object made for the purpose of covering the body, excluding jewelry and accessories.") (base/work-type "300266639" "Clothing"))
(defn coin               () (doc "Object typically made of metal, used as currency.") (base/work-type "300037222" "Coin"))
(defn decorative-arts    () (doc "Objects that are primarily utilitarian in form or function but have aesthetic value, including ceramics, furniture, textiles, glass, clocks and so on.") (base/work-type "300411641" "Decorative Arts"))
(defn drawing            () (doc "Object created by application of lines on a surface.") (base/work-type "300033973" "Drawing"))
(defn frame              () (doc "Part of an object which surrounds a generally two dimensional artwork such as a painting.") (base/work-type "300404391" "Frame"))
(defn furniture          () (doc "Objects used for sitting, reclining, or storage, such as a chair or cabinet.") (base/work-type "300037680" "Furniture"))
(defn jewelry            () (doc "Objects worn on the body for adornment rather than function typically of precious materials.") (base/work-type "300209286" "Jewelry"))
(defn lithograph         () (doc "Prints created using the process of lithography.") (base/work-type "300041379" "Lithograph"))
(defn manuscript         () (doc "Handwritten books, typically decorated and illustrated.") (base/work-type "300265483" "Manuscript"))
(defn map-object         () (doc "Flat object which depicts a representation of the Earth's surface, including physical and/or political features.") (base/work-type "300028094" "Map"))
(defn miniature          () (doc "A painting on a very small scale, often excised from an illuminated Manuscript.") (base/work-type "300033936" "Miniature"))
(defn mosaic             () (doc "Objects created by arrangement of small pieces of durable material, such as stone or colored glass.") (base/work-type "300015342" "Mosaic"))
(defn musical-instrument () (doc "Object whose primary function is to enable the user to create music.") (base/work-type "300041620" "Musical Instrument"))
(defn painting           () (doc "Object created by application of colored liquid onto a surface.") (base/work-type "300033618" "Painting"))
(defn photograph         () (doc "Object produced by chemical action of light on a sensitive film.") (base/work-type "300046300" "Photograph"))
(defn print              () (doc "Objects created by transferring an image using a printing process.") (base/work-type "300041273" "Print"))
(defn sculpture          () (doc "Object created by carving or engraving a hard material or molding a malleable material.") (base/work-type "300047090" "Sculpture"))
(defn stained-glass      () (doc "Objects made of colored glass, often in the form of a window, meant to be observed through refracted light.") (base/work-type "300263722" "Stained Glass"))
(defn tapestry           () (doc "A woven textile object, typically hung on a wall.") (base/work-type "300205002" "Tapestry"))
