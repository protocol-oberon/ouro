;; aat/provenance-type: the provenance types Linked Art's examples use, each a Type, to
;; classify an event of provenance or a part of one. Generated by scripts/aat/generate.pl from
;; scripts/aat/examples.tsv: regenerate it, never edit it.
(import std/base)

(export promise
        commissioning
        theft
        sale-of-stolen-goods
        loan
        return-of-loan
        gift)

(define/constant promise              (doc "The Activity is a promise, as of a gift or a payment. From Linked Art's examples, not its recommended list.") (base/aat "300435599" "Promise"))
(define/constant commissioning        (doc "The Activity or Payment is a commission. From Linked Art's examples, not its recommended list.") (base/aat "300393199" "Commissioning"))
(define/constant theft                (doc "The TransferOfCustody is a theft. From Linked Art's examples, not its recommended list.") (base/aat "300055292" "Theft"))
(define/constant sale-of-stolen-goods (doc "The TransferOfCustody is a sale of stolen goods. From Linked Art's examples, not its recommended list.") (base/aat "300438484" "sale of stolen goods"))
(define/constant loan                 (doc "The TransferOfCustody is a loan. From Linked Art's examples, not its recommended list.") (base/aat "300417645" "Loan"))
(define/constant return-of-loan       (doc "The TransferOfCustody is the return of a loan. From Linked Art's examples, not its recommended list.") (base/aat "300438467" "Return of Loan"))
(define/constant gift                 (doc "The Activity is a gift. From Linked Art's examples, not its recommended list.") (base/aat "300417637" "Gift"))
