;; aat/role-type: the role types Linked Art's examples use, each a Type, to classify a part of
;; an Activity by the role of who carries it out. Generated by scripts/aat/generate.pl from
;; scripts/aat/examples.tsv: regenerate it, never edit it.
(import std/base)

(export director
        producer)

(define/constant director (doc "The part of a creation is the work of its director. From Linked Art's examples, not its recommended list.") (base/aat "300025654" "Director"))
(define/constant producer (doc "The part of a creation is the work of its producer. From Linked Art's examples, not its recommended list.") (base/aat "300197742" "Producer"))
