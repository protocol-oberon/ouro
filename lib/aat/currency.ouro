;; aat/currency: the currencies Linked Art recommends, from linked.art/model/vocab/recommended,
;; each a Currency, for a MonetaryAmount. Generated by scripts/aat/generate.pl from
;; scripts/aat/recommended.tsv: regenerate it, never edit it.
(import std/provenance)

(export british-pounds
        canadian-dollar
        euros
        japanese-yen
        swiss-franc
        us-dollars)

(defn british-pounds  () (doc "British Pounds, a currency.") (provenance/currency "300411998" "British Pounds"))
(defn canadian-dollar () (doc "Canadian Dollars, a currency.") (provenance/currency "300412000" "Canadian Dollars"))
(defn euros           () (doc "Euros, a currency.") (provenance/currency "300411996" "Euros"))
(defn japanese-yen    () (doc "Japanese Yen, a currency.") (provenance/currency "300411997" "Japanese Yen"))
(defn swiss-franc     () (doc "Swiss Francs, a currency.") (provenance/currency "300412001" "Swiss Francs"))
(defn us-dollars      () (doc "US Dollars, a currency.") (provenance/currency "300411994" "US Dollars"))
