;; linked.art's example, written in Ouro: https://linked.art/example/concept/painting/4
(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure concept ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "concept/" slug)) :type "Type" :_label label))

(document concept-painting-4
  (-> (concept "painting/4" "Local Copy of Painting")
      (with :context   "https://linked.art/ns/v1/linked-art.json")
      (with :member_of ((:id (example "set/conceptScheme") :type "Set" :_label "Local Concept Scheme")))))
