;; linked.art's example, written in Ouro: https://linked.art/example/person/rembrandt/13
(import std/base)
(import std/time)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure person #record (#string slug #string label)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

;; Born on a day, and died on a day in a place
(graph person-rembrandt-13
  (-> (person "rembrandt/13" "Rembrandt")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :born    (:type "Birth" :timespan (time/day "1606-07-15")))
      (with :died    (:type          "Death"
                      :timespan      (time/day "1669-10-04")
                      :took_place_at (array (base/tgn "7006952" "Amsterdam"))))))
