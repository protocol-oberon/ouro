;; linked.art's example, written in Ouro: https://linked.art/example/provenance/4
(import std/vocab)
(import aat/object-type)
(import aat/right-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure provenance #record (#string slug #string label)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (list vocab/provenance-activity)))

(define/constant percent (:id #uri "http://qudt.org/3.0.0/vocab/unit/Percent" :type "MeasurementUnit" :_label "Percent"))

(define/procedure ownership #record (#string label)
  (:type "Right" :_label label :classified_as (list right-type/ownership-right)))

;; A share of ownership: a Right measured in percent, possessed by its owner
(define/procedure share #record (#string label #number part #string owner)
  (-> (ownership label)
      (with :dimension    ((:type "Dimension" :value part :unit percent)))
      (with :possessed_by ((:type "Group" :_label owner)))))

;; Two dealers trade shares: each new share establishes a right and invalidates the old one.
;; linked.art gives the 60% share the value 70, kept here as it publishes it.
(graph provenance-4
  (-> (provenance "4" "Trading Shares of Painting between Two Dealers")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    ((:type        "RightAcquisition"
                       :establishes (list (with (share "40% Ownership by Dealer 1" 40 "Dealer 1")
                                           :applies_to ((:type "HumanMadeObject" :_label "Painting" :classified_as (list object-type/painting)))))
                       :invalidates (list (ownership "30% Ownership by Dealer 1")))
                      (:type        "RightAcquisition"
                       :establishes (list (share "60% Ownership by Dealer 2" 70 "Dealer 2"))
                       :invalidates (list (ownership "70% Ownership by Dealer 2")))))))
