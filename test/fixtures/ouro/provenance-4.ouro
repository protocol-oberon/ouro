;; linked.art's example, written in Ouro: https://linked.art/example/provenance/4
(import std/vocab)
(import aat/object-type)
(import aat/right-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure provenance ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(define/constant percent (:id <"http://qudt.org/3.0.0/vocab/unit/Percent" ⊢ uri> :type "MeasurementUnit" :_label "Percent"))

(define/procedure ownership ⊢ record (<label ⊢ string>)
  (:type "Right" :_label label :classified_as (array right-type/ownership-right)))

;; A share of ownership: a Right measured in percent, possessed by its owner
(define/procedure share ⊢ record (<label ⊢ string> <part ⊢ number> <owner ⊢ string>)
  (-> (ownership label)
      (with :dimension    ((:type "Dimension" :value part :unit percent)))
      (with :possessed_by ((:type "Group" :_label owner)))))

;; Two dealers trade shares: each new share establishes a right and invalidates the old one.
;; linked.art gives the 60% share the value 70, kept here as it publishes it.
(document provenance-4
  (-> (provenance "4" "Trading Shares of Painting between Two Dealers")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    ((:type        "RightAcquisition"
                       :establishes (array (with (share "40% Ownership by Dealer 1" 40 "Dealer 1")
                                           :applies_to ((:type "HumanMadeObject" :_label "Painting" :classified_as (array object-type/painting)))))
                       :invalidates (array (ownership "30% Ownership by Dealer 1")))
                      (:type        "RightAcquisition"
                       :establishes (array (share "60% Ownership by Dealer 2" 70 "Dealer 2"))
                       :invalidates (array (ownership "70% Ownership by Dealer 2")))))))
