;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/50
(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; The least an object can be: an id, a type and a label
(document object-nightwatch-50
  (with (object "nightwatch/50" "Night Watch by Rembrandt")
   :context "https://linked.art/ns/v1/linked-art.json"))
