;; linked.art's example, written in Ouro: https://linked.art/example/object/4
(import std/base)
(import std/time)
(import std/vocab)
(import aat/object-type)
(import aat/technique)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; Its making: by what technique, when, where, by whom, and influenced by its sitter
(graph object-4
  (-> (object "4" "Mona Lisa")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (list object-type/painting))
      (with :produced_by   (:type           "Production"
                            :technique      (list technique/painting-technique)
                            :timespan       (with (time/year-range "1503" "1506")
                                             :identified_by (list (base/name vocab/display-name "1503-1506")))
                            :took_place_at  (list (base/tgn "7000457" "Florence, Italy"))
                            :carried_out_by (list (base/ulan "500010879" "Person" "Leonardo da Vinci"))
                            :influenced_by  (list (base/ulan "500341678" "Person" "Lisa del Giocondo"))))))
