;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/7
(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

(define/procedure place ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "place/" slug)) :type "Place" :_label label))

;; Where the painting is now: one place, not a set of them
(document object-spring-7
  (-> (object "spring/7" "Jeanne (Spring) by Manet")
      (with :context          "https://linked.art/ns/v1/linked-art.json")
      (with :current_location (place "W204" "Gallery W204"))))
