;; linked.art's example, written in Ouro: https://linked.art/example/text/koot_nightwatch/40
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure text ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "text/" slug)) :type "LinguisticObject" :_label label))

(document text-koot-nightwatch-40
  (-> (text "koot_nightwatch/40" "Content of Koot's Night Watch")
      (with :context  "https://linked.art/ns/v1/linked-art.json")
      (with :used_for ((:type           "Activity"
                        :_label         "MI's Publishing"
                        :classified_as  (array vocab/publication-activity)
                        :carried_out_by ((:id (example "group/meulenhoff") :type "Group" :_label "Meulenhoff International")))))))
