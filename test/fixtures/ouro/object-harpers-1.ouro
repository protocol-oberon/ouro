;; linked.art's example, written in Ouro: https://linked.art/example/object/harpers/1
(import aat/object-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; One printed poster: the object, as opposed to the image it shows, which every copy shares
(document object-harpers-1
  (-> (object "harpers/1" "Poster Item")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/print))
      (with :shows         ((:id (example "visual/harpers") :type "VisualItem" :_label "Visual Content of Harpers")))))
