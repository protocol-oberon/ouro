;; linked.art's example, written in Ouro: https://linked.art/example/digital/spring/1
(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure digital ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "digital/" slug)) :type "DigitalObject" :_label label))

(document digital-spring-1
  (-> (digital "spring/1" "Jeanne (Spring) (Digital)")
      (with :context         "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by   ((:type "Name" :content "Jeanne (Spring)")))
      (with :digitally_shows ((:id (example "visual/spring") :type "VisualItem" :_label "Visual Content of Spring")))))
