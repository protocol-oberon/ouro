;; linked.art's example, written in Ouro: https://linked.art/example/event/19c/1
(import std/base)
(import std/time)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure period #record (#string slug #string label)
  (:id (example (+ "event/" slug)) :type "Period" :_label label))

(graph event-19c-1
  (-> (period "19c/1" "19th Century")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (array (base/name vocab/primary-name "19th Century")))
      (with :timespan      (time/year-range "1800" "1899"))))
