;; linked.art's example, written in Ouro: https://linked.art/example/text/koot_nightwatch_ch1/2
(import std/base)
(import std/object)
(import std/vocab)
(import aat/dimension-type)
(import aat/object-type)
(import aat/statement-type)
(import aat/unit)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure text #record (#string slug #string label)
  (:id (example (+ "text/" slug)) :type "LinguisticObject" :_label label))

;; A chapter's pages, both as a statement and counted
(graph text-koot-nightwatch-ch1-2
  (-> (text "koot_nightwatch_ch1/2" "Chapter 1 of Koot")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as  (list object-type/chapter))
      (with :identified_by  (list (base/name vocab/primary-name "Introduction")))
      (with :referred_to_by (list (base/statement statement-type/pagination-statement "5 - 15")))
      (with :dimension      (list (with (object/dimension dimension-type/count-of 10 unit/pages) :_label "10 pages")))))
