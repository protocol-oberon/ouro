;; linked.art's example, written in Ouro: https://linked.art/example/provenance/durand_payne/1
(import std/base)
(import std/provenance)
(import std/time)
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure provenance ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(define/procedure node ⊢ record (<path ⊢ string> <type ⊢ string> <label ⊢ string>)
  (:id (example path) :type type :_label label))

;; A purchase known only by its change of title, in a year
(document provenance-durand-payne-1
  (-> (provenance "durand_payne/1" "Purchase of Spring by Payne")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (array (base/name vocab/primary-name "Purchase of Spring by Payne from Durand-Ruel")))
      (with :timespan      (time/year "1909"))
      (with :part          (array (with (provenance/acquisition (node "object/spring" "HumanMadeObject" "Spring")
                                                                (node "person/durand" "Person" "Durand-Ruel Gallery")
                                                                (node "person/payne" "Person" "Oliver Payne"))
                                   :_label "Ownership of Spring to Payne")))))
