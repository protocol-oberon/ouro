;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/support
(import std/object)
(import aat/part-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; The painting's support, as a part of its own, with what it is made of
(graph object-spring-support
  (-> (object "spring/support" "Support of Spring")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as  (array part-type/support))
      (with :referred_to_by (array (object/material-statement "Canvas")))
      (with :part_of        (array (object "spring" "Jeanne (Spring) by Manet")))))
