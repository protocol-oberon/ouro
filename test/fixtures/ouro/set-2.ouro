;; linked.art's example, written in Ouro: https://linked.art/example/set/2
(import std/base)
(import std/provenance)
(import std/vocab)
(import aat/currency/iso)
(import aat/price-type)
(import aat/statement-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure set ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "set/" slug)) :type "Set" :_label label))

;; A lot's starting price: an amount of money, with how it is shown and where it was learnt
(document set-2
  (-> (set "2" "Set of Objects for Lot 812")
      (with :context   "https://linked.art/ns/v1/linked-art.json")
      (with :dimension (array (-> (provenance/money 500 iso/us-dollars)
                                 (with :_label         "$500")
                                 (with :classified_as  (array price-type/starting-price))
                                 (with :identified_by  (array (base/name vocab/display-name "500 US Dollars")))
                                 (with :referred_to_by (array (base/statement statement-type/note "From personal correspondence"))))))))
