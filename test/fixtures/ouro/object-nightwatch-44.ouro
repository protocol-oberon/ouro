;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/44
(import std/object)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

(graph object-nightwatch-44
  (-> (object "nightwatch/44" "Night Watch by Rembrandt")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :referred_to_by (list (object/material-statement "Oil on Canvas")))))
