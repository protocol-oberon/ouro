;; linked.art's example, written in Ouro: https://linked.art/example/event/exhab/1
(import std/base)
(import std/time)
(import std/vocab)
(import aat/activity-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure activity #record (#string slug #string label)
  (:id (example (+ "event/" slug)) :type "Activity" :_label label))

;; An exhibition as a whole, over both its venues
(document event-exhab-1
  (-> (activity "exhab/1" "Manet and Modern Beauty")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array activity-type/exhibiting-in-multiple-locations))
      (with :identified_by (array (base/name vocab/primary-name "Manet and Modern Beauty")))
      (with :timespan      (time/day-range "2019-05-26" "2020-01-12"))
      (with :influenced_by ((:id (example "concept/exhidea") :type "PropositionalObject" :_label "Idea for Manet and Modern Beauty")))))
