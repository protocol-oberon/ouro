;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/4
(import std/object)
(import aat/language/iso)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A materials statement, in English
(document object-nightwatch-4
  (-> (object "nightwatch/4" "Night Watch by Rembrandt")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :referred_to_by (array (with (object/material-statement "Oil on Canvas") :language (array iso/english))))))
