;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/9
(import aat/digital-type)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; The museum's web page about the painting: a text, carried by a digital object at a URL
(graph object-spring-9
  (-> (object "spring/9" "Jeanne (Spring) by Manet")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/painting))
      (with :identified_by ((:type "Name" :content "Jeanne (Spring)")))
      (with :subject_of    ((:type                 "LinguisticObject"
                             :digitally_carried_by ((:type          "DigitalObject"
                                                     :classified_as (array digital-type/web-page)
                                                     :format        "text/html"
                                                     :access_point  ((:id #uri "https://www.getty.edu/art/collection/object/103QTZ" :type "DigitalObject")))))))))
