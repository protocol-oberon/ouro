;; linked.art's example, written in Ouro: https://linked.art/example/group/rembrandthuis/1
(import std/actor)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure group #record (#string slug #string label)
  (:id (example (+ "group/" slug)) :type "Group" :_label label))

;; A museum's contact points, each an Identifier std/actor builds
(graph group-rembrandthuis-1
  (-> (group "rembrandthuis/1" "Rembrandt House Museum")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :contact_point (array (actor/street-address "Jodenbreestraat 4, 1011 NK Amsterdam")
                                  (actor/telephone "+31-20-520-0400")
                                  (actor/email "museum@rembrandthuis.nl")))))
