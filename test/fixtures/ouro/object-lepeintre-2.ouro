;; linked.art's example, written in Ouro: https://linked.art/example/object/lepeintre/2
(import std/time)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; The destroyed painting of lepeintre/1, with the cause of its destruction: a plane crash, an
;; Event, not an Activity, as no one carried it out
(graph object-lepeintre-2
  (-> (object "lepeintre/2" "Le Peintre by Picasso")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (list object-type/painting))
      (with :destroyed_by  (:type      "Destruction"
                            :_label    "Destruction of Le Peintre"
                            :timespan  (time/span "1998-09-02T22:20:00Z" "1998-09-02T22:40:00Z")
                            :caused_by ((:id (example "event/sr111crash") :type "Event" :_label "Crash of Swiss Air 111"))))))
