;; linked.art's example, written in Ouro: https://linked.art/example/object/catalog/1
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

(define/procedure visual #record (#string slug #string label)
  (:id (example (+ "visual/" slug)) :type "VisualItem" :_label label))

;; A copy of an exhibition catalogue: the object shows the images printed in it and carries
;; its text
(document object-catalog-1
  (-> (object "catalog/1" "Copy of Exhibition Catalog")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/exhibition-catalog))
      (with :shows         (array (visual "spring" "Visual Content of Spring")
                                  (visual "houses" "Visual Content of Houses in Provence")))
      (with :carries       ((:id (example "text/catalogtext") :type "LinguisticObject" :_label "Exhibition Catalog Text")))))
