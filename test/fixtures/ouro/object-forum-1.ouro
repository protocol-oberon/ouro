;; linked.art's example, written in Ouro: https://linked.art/example/object/forum/1
(import std/base)
(import std/vocab)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; An uncertain attribution: the painting is possibly by Corrodi, so his part of its making is
;; assigned by an attribution classified Possibly By, not stated as fact
(graph object-forum-1
  (-> (object "forum/1" "Forum Romanum")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/painting))
      (with :identified_by (array (base/name vocab/primary-name "Forum Romanum")))
      (with :produced_by   (:type          "Production"
                            :attributed_by ((:type              "AttributeAssignment"
                                             :classified_as     (array (base/aat "300404272" "Possibly By"))
                                             :assigned          ((:type           "Production"
                                                                  :carried_out_by ((:id (example "person/corrodi") :type "Person" :_label "Salomon Corrodi"))))
                                             :assigned_property "part"))))))
