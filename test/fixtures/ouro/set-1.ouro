;; linked.art's example, written in Ouro: https://linked.art/example/set/1
(import std/base)
(import std/time)
(import aat/set-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure set #record (#string slug #string label)
  (:id (example (+ "set/" slug)) :type "Set" :_label label))

;; A museum's collection, made on the day the museum was founded
(graph set-1
  (-> (set "1" "Collection of the Met")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as  (array set-type/collection))
      (with :identified_by  ((:type "Name" :content "Art Collection of the Metropolitan Museum of Art")))
      (with :referred_to_by (array (base/description "Over 2 million works, divided into 17 curatorial departments")))
      (with :created_by     (:type "Creation" :timespan (with (time/day "1870-04-13") :_label "April 13th, 1870")))))
