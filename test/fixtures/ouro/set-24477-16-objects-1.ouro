;; linked.art's example, written in Ouro: https://linked.art/example/set/24477_16_objects/1
(import std/base)
(import std/vocab)
(import aat/identifier-type)
(import aat/set-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure set #record (#string slug #string label)
  (:id (example (+ "set/" slug)) :type "Set" :_label label))

;; An auction lot: the set of objects sold together, named and numbered
(document set-24477-16-objects-1
  (-> (set "24477_16_objects/1" "Set of Objects for Lot 16")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array set-type/auction-lot))
      (with :identified_by (array (base/name vocab/primary-name "Lot 16: Le Printemps")
                                  (base/identifier identifier-type/lot-number "16")))))
