;; linked.art's example, written in Ouro: https://linked.art/example/provenance/transfer/1
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure provenance #record (#string slug #string label)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(define/procedure node #record (#string path #string type #string label)
  (:id (example path) :type type :_label label))

;; A transfer, when what passed, title or custody, is not known
(graph provenance-transfer-1
  (-> (provenance "transfer/1" "Transfer of Painting")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    ((:type             "Transfer"
                       :transferred      (array (node "object/example" "HumanMadeObject" "Example Painting"))
                       :transferred_from (array (node "person/person1" "Person" "Person 1"))
                       :transferred_to   (array (node "person/person2" "Person" "Person 2")))))))
