;; linked.art's example, written in Ouro: https://linked.art/example/person/rembrandt/14
(import std/time)
(import aat/activity-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure person #record (#string slug #string label)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

;; An activity a person took part in without carrying it out: their own burial
(graph person-rembrandt-14
  (-> (person "rembrandt/14" "Rembrandt")
      (with :context         "https://linked.art/ns/v1/linked-art.json")
      (with :participated_in ((:type          "Activity"
                               :classified_as (array activity-type/burial)
                               :timespan      (time/day-range "1669-10-04" "1669-11-01")
                               :took_place_at ((:id (example "place/westerkerk") :type "Place" :_label "Place of Westerkerk")))))))
