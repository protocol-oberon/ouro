;; linked.art's example, written in Ouro: https://linked.art/example/object/13
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

;; A painting; linked.art gives it no label
(graph object-13
  (:context       "https://linked.art/ns/v1/linked-art.json"
   :id            (example "object/13")
   :type          "HumanMadeObject"
   :classified_as (list object-type/painting)))
