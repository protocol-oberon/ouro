;; linked.art's example, written in Ouro: https://linked.art/example/object/torosaurus/1
(import std/time)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A fossil, never made: its history begins with its finding, an Encounter, in 1891
(document object-torosaurus-1
  (-> (object "torosaurus/1" "Torosaurus Gladius")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :encountered_by ((:type           "Encounter"
                              :timespan       (time/year "1891")
                              :carried_out_by ((:id (example "person/hatcher") :type "Person" :_label "John Bell Hatcher")))))))
