;; linked.art's example, written in Ouro: https://linked.art/example/provenance/2
(import std/vocab)
(import aat/right-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/constant painting (:type "HumanMadeObject" :_label "Painting"))
(define/constant museum   (:type "Group" :_label "Museum"))

;; Title passes to a museum, and with it the right of ownership it establishes
(graph provenance-2
  (:context       "https://linked.art/ns/v1/linked-art.json"
   :id            (example "provenance/2")
   :type          "Activity"
   :classified_as (list vocab/provenance-activity)
   :part          ((:type "Acquisition" :transferred_title_of (list painting) :transferred_title_to (list museum))
                   (:type        "RightAcquisition"
                    :establishes ((:type          "Right"
                                   :_label        "Right of Ownership for Painting"
                                   :classified_as (list right-type/ownership-right)
                                   :possessed_by  (list museum)
                                   :applies_to    (list painting)))))))
