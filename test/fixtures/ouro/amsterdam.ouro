(import std/base)

;; A project's own URIs stay in the project: std builds Linked Art's nodes, not their ids
(defn example #uri (#str path)
  (+ "https://linked.art/example/" path))

(defn place #rec (#str slug #str label)
  (:id (example (+ "place/" slug)) :type "Place" :_label label))

;; -> threads the place through its steps; with sets each property, a set written as an array
(graph amsterdam
  (-> (place "amsterdam/1" "Amsterdam")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as  ((base/aat "300008389" "City")))
      (with :identified_by  ((:type "Name" :content "Amsterdam")))
      (with :referred_to_by ((base/description "Amsterdam is a city in the Netherlands")))
      (with :part_of        ((-> (place "netherlands" "Netherlands")
                                 (with :classified_as ((base/aat "300128207" "Nation"))))))))
