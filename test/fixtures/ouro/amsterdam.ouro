;; Will be in std: Linked Art's own patterns. Named std/... here until modules exist
(defn std/core #rec (#uri id #str type #str label)
  (:id id :type type :_label label))

(defn std/aat #rec (#str id #str label)
  (std/core #uri (+ "http://vocab.getty.edu/aat/" id) "Type" label))

(defn std/name #rec (#str content)
  (:type "Name" :content content))

(defn std/classified #rec (#rec r #rec t)
  (with r :classified_as (list t)))

(defn example #uri (#str path)
  (+ "https://linked.art/example/" path))

(defn place #rec (#str slug #str label)
  (std/core (example (+ "place/" slug)) "Place" label))

(defn brief-text #rec (#str content)
  (:type          "LinguisticObject"
   :classified_as ((-> (std/aat "300435416" "Description")
                       (std/classified (std/aat "300418049" "Brief Text"))))
   :content       content))

;; Steps: each takes a record first and returns it extended, so they thread with ->
(defn named     #rec (#rec r #str n)     (with r :identified_by ((std/name n))))
(defn described #rec (#rec r #str text)  (with r :referred_to_by ((brief-text text))))
(defn part-of   #rec (#rec r #rec whole) (with r :part_of (list whole)))

(graph amsterdam
  (-> (place "amsterdam/1" "Amsterdam")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (std/classified (std/aat "300008389" "City"))
      (named "Amsterdam")
      (described "Amsterdam is a city in the Netherlands")
      (part-of (-> (place "netherlands" "Netherlands")
                   (std/classified (std/aat "300128207" "Nation"))))))
