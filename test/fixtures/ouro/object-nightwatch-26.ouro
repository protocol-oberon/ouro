;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/26
(import std/base)
(import std/time)
(import aat/object-type)
(import aat/technique)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A conservation treatment: a modification, by its technique
(graph object-nightwatch-26
  (-> (object "nightwatch/26" "The Night Watch")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/painting))
      (with :modified_by   ((:type           "Modification"
                             :_label         "Conservation of Night Watch"
                             :referred_to_by (array (base/description "Minor conservation work in response to earlier survey"))
                             :technique      (array technique/cleaning)
                             :timespan       (time/year-range "2020" "2021")
                             :carried_out_by ((:id (example "group/rijksmuseum") :type "Group" :_label "Rijksmuseum"))
                             :part_of        ((:id (example "event/operation_nightwatch") :type "Activity" :_label "Operation Night Watch")))))))
