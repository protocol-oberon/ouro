;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/41
(import std/base)
(import std/vocab)
(import aat/language/iso)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

(graph object-nightwatch-41
  (-> (object "nightwatch/41" "Night Watch by Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (array (with (base/name vocab/primary-name "The Night Watch") :language (array iso/english))))))
