;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/14
(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

(define/procedure place #record (#string slug #string label)
  (:id (example (+ "place/" slug)) :type "Place" :_label label))

;; On show away from its usual gallery: where it belongs, and where it is now
(document object-spring-14
  (-> (object "spring/14" "Jeanne (Spring) by Manet")
      (with :context                    "https://linked.art/ns/v1/linked-art.json")
      (with :current_permanent_location (place "W204" "Gallery W204"))
      (with :current_location           (place "E100" "Exhibition Gallery 100"))))
