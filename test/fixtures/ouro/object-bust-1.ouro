;; linked.art's example, written in Ouro: https://linked.art/example/object/bust/1
(import std/base)
(import aat/object-type)
(import aat/technique)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A sculpture, made by sculpting, by an artist known to the Getty ULAN
(document object-bust-1
  (-> (object "bust/1" "Bust of a Man")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/sculpture))
      (with :produced_by   (:type           "Production"
                            :technique      (array technique/sculpting)
                            :carried_out_by (array (base/ulan "500015886" "Person" "Francis Harwood"))))))
