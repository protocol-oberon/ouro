;; linked.art's example, written in Ouro: https://linked.art/example/object/flw_house/1
(import std/base)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A building is an object too, moved here to a museum's grounds. linked.art classifies it as
;; a plain Type, not a type of work, and gives its name no classification.
(document object-flw-house-1
  (-> (object "flw_house/1" "Frank Lloyd Wright House")
      (with :context          "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as    (array (base/aat "300004792" "Building")))
      (with :identified_by    ((:type "Name" :content "Frank Lloyd Wright House")))
      (with :current_location (:id (example "place/crystal_bridges") :type "Place" :_label "Crystal Bridges"))))
