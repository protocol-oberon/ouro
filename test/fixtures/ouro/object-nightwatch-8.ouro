;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/8
(import std/base)
(import std/object)
(import std/vocab)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A dimension with the words it is shown in
(define/procedure shown #record (#record dimension #string as)
  (with dimension :identified_by (array (base/name vocab/display-name as))))

(graph object-nightwatch-8
  (-> (object "nightwatch/8" "Night Watch by Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/painting))
      (with :dimension     (array (shown (object/width 453.5 object/centimeters) "453.5 cm wide")
                                  (shown (object/height 379.5 object/centimeters) "379.5 cm high")))))
