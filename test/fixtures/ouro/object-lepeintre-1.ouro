;; linked.art's example, written in Ouro: https://linked.art/example/object/lepeintre/1
(import std/time)
(import aat/object-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A destroyed painting: its destruction, within twenty minutes on an evening in 1998
(document object-lepeintre-1
  (-> (object "lepeintre/1" "Le Peintre by Picasso")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/painting))
      (with :destroyed_by  (:type     "Destruction"
                            :_label   "Destruction of Le Peintre"
                            :timespan (let ($struck <"1998-09-02T22:20:00Z" ⊢ date>)
                                        (time/span struck (+ struck (minutes 20))))))))
