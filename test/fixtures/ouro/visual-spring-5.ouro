;; linked.art's example, written in Ouro: https://linked.art/example/visual/spring/5
(import std/base)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure visual ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "visual/" slug)) :type "VisualItem" :_label label))

;; A kind of thing a painting shows, not a particular one: a parasol
(document visual-spring-5
  (-> (visual "spring/5" "Visual Content of Spring")
      (with :context                     "https://linked.art/ns/v1/linked-art.json")
      (with :represents_instance_of_type (array (base/aat "300046218" "Parasol")))))
