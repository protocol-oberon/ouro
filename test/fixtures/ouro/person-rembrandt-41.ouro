;; linked.art's example, written in Ouro: https://linked.art/example/person/rembrandt/41
(import std/base)
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure person ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

;; A name to show, and a name to sort by
(document person-rembrandt-41
  (-> (person "rembrandt/41" "Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (array (base/name vocab/primary-name "Rembrandt van Rijn")
                                  (base/name vocab/sort-name "van Rijn, Rembrandt Harmenszoon")))))
