;; linked.art's example, written in Ouro: https://linked.art/example/object/letter/1
(import std/base)
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A letter in an archive: a member of the set of the family's letters. linked.art classifies
;; it as a plain Type, not a type of work.
(document object-letter-1
  (-> (object "letter/1" "Obermeyer 1920")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array (base/aat "300026879" "Letter")))
      (with :identified_by (array (base/name vocab/primary-name "Obermeyer, Bertha (1920)")))
      (with :member_of     ((:id (example "set/archive_sfl") :type "Set" :_label "Stieglitz Family Letters")))))
