;; linked.art's example, written in Ouro: https://linked.art/example/object/chess/1
(import std/base)
(import std/object)
(import std/vocab)
(import aat/dimension-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; An object of many pieces, counted: 36 components. linked.art measures in the AAT's
;; Components, the part type, used here as a unit.
(document object-chess-1
  (-> (object "chess/1" "Miniature Chess")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (array (base/name vocab/primary-name "Vessel with miniature chess set")))
      (with :dimension     (array (object/dimension dimension-type/count-of 36 (object/unit "300241583" "Components"))))))
