;; linked.art's example, written in Ouro: https://linked.art/example/concept/exhidea/2
(import std/base)
(import std/exhibition)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(graph concept-exhidea-2
  (-> (exhibition/concept (example "concept/exhidea/2") "Idea for Manet and Modern Beauty")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (list (base/name vocab/primary-name "Manet and Modern Beauty")))
      (with :created_by    (:type "Creation" :influenced_by (list (base/ulan "500010363" "Person" "Manet"))))))
