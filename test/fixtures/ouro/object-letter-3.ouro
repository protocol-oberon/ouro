;; linked.art's example, written in Ouro: https://linked.art/example/object/letter/3
(import std/base)
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; Where the letter is kept: held in an archival box, itself an object
(document object-letter-3
  (-> (object "letter/3" "Obermeyer 1920")
      (with :context              "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by        (array (base/name vocab/primary-name "Obermeyer, Bertha (1920)")))
      (with :member_of            ((:id (example "set/archive_sfl") :type "Set" :_label "Stieglitz Family Letters")))
      (with :held_or_supported_by (array (object "box55" "Archival Box 55")))))
