;; linked.art's example, written in Ouro: https://linked.art/example/object/letter/2
(import std/base)
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

(define/constant letters
  (:id (example "set/archive_sfl") :type "Set" :_label "Stieglitz Family Letters"))

;; The letter's place in the order of its archive: a sort value, assigned under the influence of
;; the set it sorts within
(document object-letter-2
  (-> (object "letter/2" "Obermeyer 1920")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (array (base/name vocab/primary-name "Obermeyer, Bertha (1920)")
                                  (with (base/identifier vocab/sort-value "000001")
                                   :assigned_by ((:type "AttributeAssignment" :influenced_by (array letters))))))
      (with :member_of     (array letters))))
