;; linked.art's example, written in Ouro: https://linked.art/example/provenance/spring_getty/1
(import std/vocab)
(import aat/provenance-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure provenance #record (#string slug #string label)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(define/procedure node #record (#string path #string type #string label)
  (:id (example path) :type type :_label label))

;; The loan's return: custody passes back
(document provenance-spring-getty-1
  (-> (provenance "spring_getty/1" "Return of Spring to Getty")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    ((:type                     "TransferOfCustody"
                       :_label                   "Return"
                       :classified_as            (array provenance-type/return-of-loan)
                       :transferred_custody_of   (array (node "object/spring" "HumanMadeObject" "Spring"))
                       :transferred_custody_from (array (node "group/aic" "Group" "Art Institute of Chicago"))
                       :transferred_custody_to   (array (node "group/getty" "Group" "Getty Museum")))))))
