;; linked.art's example, written in Ouro: https://linked.art/example/text/harpers/1
(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure text ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "text/" slug)) :type "LinguisticObject" :_label label))

;; The words of a poster, part of what it shows
(document text-harpers-1
  (-> (text "harpers/1" "Textual component of Harpers")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :content "Harper's. January contains Roden's corner. A Novel by Henry Seton Merriman [...]")
      (with :part_of ((:id (example "visual/harpers") :type "VisualItem" :_label "Visual Content of Harpers")))))
