;; linked.art's example, written in Ouro: https://linked.art/example/set/archive_sfl/2
(import std/base)
(import std/vocab)
(import aat/set-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure set #record (#string slug #string label)
  (:id (example (+ "set/" slug)) :type "Set" :_label label))

;; The box an archival grouping's members are kept in
(graph set-archive-sfl-2
  (-> (set "archive_sfl/2" "Stieglitz Family Letters")
      (with :context              "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as        (list set-type/archival-sub-grouping))
      (with :identified_by        (list (base/name vocab/primary-name "Stieglitz Family Letters")))
      (with :members_contained_by ((:id (example "object/box55") :type "HumanMadeObject" :_label "Archival Box 55")))))
