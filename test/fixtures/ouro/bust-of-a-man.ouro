(import std/base)

;; A function of no parameters is a constant: named as a value, it is its result. Its
;; signature, #rec, is the return type, written before the parameters
(defn sculpting #rec ()
  (base/aat "300264383" "Sculpting"))

(graph bust-of-a-man
 ;; A call with ? holes is a function of its holes
 (let ($person (base/ulan ? "Person" ?))

  (:context "https://linked.art/ns/v1/linked-art.json"

   :id     #uri "https://linked.art/example/object/bust/1"
   :type   "HumanMadeObject"
   :_label "Bust of a Man"

   :classified_as ((base/work-type "300047090" "Sculpture"))

   :produced_by   (:type           "Production"
                   :technique      (list sculpting)
                   :carried_out_by ((person "500015886" "Francis Harwood"))))))
