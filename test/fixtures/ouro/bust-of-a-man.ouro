(defun id-node! (id-of-id type-of-type lable)
   (define
     :getty-ulan "http://vocab.getty.edu/ulan/"
     :uri (case type-of-type
                ("Person"  getty-ulan)
                (otherwise getty-att)))

   :id     #uri (+ uri id-of-id)
   :type   type-of-type
   :_label lable)

(graph bust-of-a-man
 (define :getty-att "http://vocab.getty.edu/aat/")

 :context "https://linked.art/ns/v1/linked-art.json"

 :id     #uri "https://linked.art/example/object/bust/1"
 :type   "HumanMadeObject"
 :_label "Bust of a Man"

 :classified_as ((:id            #uri (+ getty-att "300047090")
                  :type          "Type"
                  :_label        "Sculpture"
                  :classified_as ((id-node! "300435443" "Type" "Type of Work"))))

 :produced_by   (:type           "Production"
                 :technique      ((id-node! "300264383" "Type"   "Sculpting"))
                 :carried_out_by ((id-node! "500015886" "Person" "Francis Harwood"))))
