;; linked.art's example, written in Ouro: https://linked.art/example/visual/harpers/1
(import std/base)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure visual ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "visual/" slug)) :type "VisualItem" :_label label))

(document visual-harpers-1
  (-> (visual "harpers/1" "Visual Content of Harpers")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :referred_to_by (array (base/description "The text and image are primarily red and black")))
      (with :represents     (array (base/aat "300025943" "Woman")))))
