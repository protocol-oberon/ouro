;; linked.art's example, written in Ouro: https://linked.art/example/object/yul_10801219/1
(import std/base)
(import std/vocab)
(import aat/identifier-type)
(import aat/object-type)
(import aat/statement-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A library's copy of a book: its catalogue number, its physical description, and the text it
;; carries, shared by every copy
(graph object-yul-10801219-1
  (-> (object "yul_10801219/1" "Yale's copy of Koot's Night Watch")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as  (list object-type/book))
      (with :identified_by  (list (base/name vocab/primary-name "Rembrandt's Night Watch. A Fascinating Story")
                                  (base/identifier identifier-type/system-number "mfhd:10801219")))
      (with :referred_to_by (list (base/statement statement-type/physical-statement "92 p. with illus.")))
      (with :carries        ((:id (example "text/koot_nightwatch") :type "LinguisticObject" :_label "Content of Koot's Night Watch")))))
