;; linked.art's example, written in Ouro: https://linked.art/example/digital/0
(import std/base)
(import std/object)
(import aat/digital-type)
(import aat/identifier-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure digital ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "digital/" slug)) :type "DigitalObject" :_label label))

;; Something the digital object points at, known by its URL alone
(define/procedure at ⊢ record (<url ⊢ uri>)
  (:id url :type "DigitalObject"))

(document digital-0
  (-> (digital "0" "Digital Image of Self-Portrait of Van Gogh")
      (with :context                 "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as           (array digital-type/digital-image))
      (with :identified_by           ((:type "Name" :content "Self-Portrait Dedicated to Paul Gauguin")
                                      (base/identifier identifier-type/local-number "47174896")))
      (with :dimension               (array (object/height 2550 object/pixels)
                                            (object/width 2087 object/pixels)))
      (with :part_of                 (array (with (at <"https://iiif.harvardartmuseums.org/manifests/object/299843" ⊢ uri>)
                                                 :_label "IIIF Manifest")))
      (with :member_of               ((:id (example "set/0") :type "Set" :_label "Images of Self-Portraits of Van Gogh")))
      (with :access_point            (array (at <"https://ids.lib.harvard.edu/ids/iiif/47174896/full/full/0/default.jpg" ⊢ uri>)))
      (with :digitally_shows         ((:type "VisualItem" :_label "Visual Content of Self-Portrait of Van Gogh")))
      (with :format                  "image/jpeg")
      (with :digitally_available_via ((:type         "DigitalService"
                                       :_label       "IIIF Service"
                                       :access_point (array (at <"https://ids.lib.harvard.edu/ids/iiif/47174896" ⊢ uri>))
                                       :conforms_to  ((:id <"https://iiif.io/api/image/2/context.json" ⊢ uri> :type "InformationObject")))))
      (with :created_by              (:type                 "Creation"
                                      :carried_out_by       ((:id (example "group/harvardartmuseums.org") :type "Group" :_label "Harvard Art Museums"))
                                      :used_specific_object ((:id     <"https://harvardartmuseums.org/collections/object/299843" ⊢ uri>
                                                              :type   "HumanMadeObject"
                                                              :_label "Self-Portrait of Van Gogh"))))))
