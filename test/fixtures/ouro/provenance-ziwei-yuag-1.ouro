;; linked.art's example, written in Ouro: https://linked.art/example/provenance/ziwei_yuag/1
(import std/provenance)
(import std/time)
(import std/vocab)
(import aat/provenance-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure provenance ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(define/procedure node ⊢ record (<path ⊢ string> <type ⊢ string> <label ⊢ string>)
  (:id (example path) :type type :_label label))

;; A gift: title passes, and nothing is paid
(document provenance-ziwei-yuag-1
  (-> (provenance "ziwei_yuag/1" "Gift of Landscape to YUAG")
      (with :context  "https://linked.art/ns/v1/linked-art.json")
      (adjoin :classified_as provenance-type/gift)
      (with :timespan (time/year "1999"))
      (with :part     (array (with (provenance/acquisition (node "object/ziwei_landscape" "HumanMadeObject" "Landscape")
                                                          (node "person/ziwei" "Person" "Xu Ziwei")
                                                          (node "group/yuag" "Group" "Yale University Art Gallery"))
                             :_label "Acquisition of Painting 1")))))
