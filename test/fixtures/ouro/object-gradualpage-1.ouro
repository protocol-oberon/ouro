;; linked.art's example, written in Ouro: https://linked.art/example/object/gradualpage/1
(import aat/object-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A page cut from a gradual: its removal diminished the book it was part of
(document object-gradualpage-1
  (-> (object "gradualpage/1" "Page from a Gradual")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/page))
      (with :removed_by    ((:type "PartRemoval" :diminished (object "gradual" "Gradual"))))))
