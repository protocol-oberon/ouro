(import std/base)

(defn example #uri (#str path)
  (+ "https://linked.art/example/" path))

(defn place #rec (#str slug #str label)
  (doc "A place among Linked Art's examples, by its slug.")
  (:id (example (+ "place/" slug)) :type "Place" :_label label))

(graph christie-ams
  (-> (place "amsterdam_auction_house/1" "Christie's AMS")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by ((:type "Name"
                             :content "Christie's Amsterdam Location")))
      (with :part_of       ((place "amsterdam/1" "Amsterdam")))))
