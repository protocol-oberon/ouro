;; linked.art's example, written in Ouro: https://linked.art/example/set/exhset/1
(import std/base)
(import std/exhibition)
(import std/time)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

;; The objects an exhibition shows, which std/exhibition builds as an Exhibition Collection
(document set-exhset-1
  (-> (exhibition/set (example "set/exhset/1") "Exhibition objects")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by  (array (base/name vocab/primary-name "Objects in Manet and Modern Beauty")))
      (with :referred_to_by (array (base/description "Objects in the exhibition Manet and Modern Beauty at the Art Institute of Chicago and the Getty Museum")))
      (with :created_by     (:type "Creation" :timespan (time/day "2019-05-01")))))
