;; linked.art's example, written in Ouro: https://linked.art/example/object/0
(import std/base)
(import std/object)
(import std/time)
(import std/vocab)
(import aat/identifier-type)
(import aat/language/iso)
(import aat/material)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

(define/procedure named #record (#string content #record language)
  (with (base/name vocab/primary-name content) :language (array language)))

;; Linked Art's fullest object: names in three languages, an accession number, a description,
;; dimensions and materials, the sets it is in, what it shows, who owns it, where it is, and
;; its making
(document object-0
  (-> (object "0" "Mona Lisa")
      (with :context          "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as    (array object-type/painting (base/aat "300133025" "Artwork")))
      (with :identified_by    (array (named "Mona Lisa" iso/english)
                                     (named "La Joconde" iso/french)
                                     (named "La Gioconda" iso/italian)
                                     (base/identifier identifier-type/accession-number "INV. 779")))
      (with :referred_to_by   (array (base/description "This portrait was doubtless started in Florence around 1503. It is thought to be of Lisa Gherardini, wife of a Florentine cloth merchant ...")))
      (with :dimension        (array (object/height 0.77 object/meters)
                                     (object/width 0.53 object/meters)))
      (with :made_of          (array material/poplar material/oil-paint))
      (with :member_of        ((:type "Set" :_label "Most expensive paintings in the world")
                               (:id #uri "http://data.louvre.example/all_holdings" :type "Set" :_label "Holdings of the Louvre")))
      (with :shows            ((:id #uri "http://data.louvre.example/visual/mona_lisa" :type "VisualItem" :_label "Visual Work of the Mona Lisa")))
      (with :equivalent       ((:id #uri "http://wikidata.org/entity/Q12418" :type "HumanMadeObject" :_label "Mona Lisa")))
      (with :current_owner    ((:id #uri "http://louvre.fr/" :type "Group" :_label "The Louvre")))
      (with :current_location (:id #uri "http://galleries.example/louvre/711" :type "Place" :_label "Room 711, Denon Wing, The Louvre, Paris"))
      (with :produced_by      (:type           "Production"
                               :timespan       (with (time/year-range "1503" "1506")
                                                :identified_by (array (base/name vocab/display-name "1503-1506")))
                               :took_place_at  (array (base/tgn "7000457" "Florence, Italy"))
                               :carried_out_by (array (base/ulan "500010879" "Person" "Leonardo da Vinci"))))))
