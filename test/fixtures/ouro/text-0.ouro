;; linked.art's example, written in Ouro: https://linked.art/example/text/0
(import std/base)
(import std/time)
(import std/vocab)
(import aat/identifier-type)
(import aat/language/iso)
(import aat/object-type)
(import aat/statement-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure text #record (#string slug #string label)
  (:id (example (+ "text/" slug)) :type "LinguisticObject" :_label label))

;; A book: what it is, what it is about, its language, who wrote it, and its publishing
(graph text-0
  (-> (text "0" "Gainsborough by Hayes")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as  (list object-type/monograph))
      (with :identified_by  (list (base/name vocab/primary-name "Gainsborough: Paintings and Drawings")
                                  (base/identifier identifier-type/isbn-identifier "0714816396")))
      (with :referred_to_by (list (base/statement statement-type/abstract "A thorough analysis of the artist's life and work")))
      (with :about          (list (base/ulan "500115200" "Person" "Gainsborough, Thomas")))
      (with :language       (list iso/english))
      (with :used_for       ((:type           "Activity"
                              :classified_as  (list vocab/publication-activity)
                              :timespan       (with (time/year "1975") :_label "1975")
                              :took_place_at  ((:type "Place" :_label "New York"))
                              :carried_out_by ((:type "Group" :_label "Phaidon")))))
      (with :created_by     (:type "Creation" :carried_out_by ((:type "Person" :_label "Hayes, John"))))))
