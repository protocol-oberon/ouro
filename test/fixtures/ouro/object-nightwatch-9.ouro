;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/9
(import std/object)
(import aat/object-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A height, and who measured it, as part of what
(document object-nightwatch-9
  (-> (object "nightwatch/9" "Night Watch by Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/painting))
      (with :dimension     (array (with (object/height 379.5 object/centimeters)
                                   :assigned_by ((:type           "AttributeAssignment"
                                                  :_label         "Measurement of the Night Watch"
                                                  :carried_out_by ((:id (example "group/nightwatchteam") :type "Group" :_label "Operation Night Watch Team"))
                                                  :part_of        ((:id (example "event/operationnightwatch") :type "Activity" :_label "Operation Night Watch")))))))))
