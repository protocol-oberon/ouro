;; linked.art's example, written in Ouro: https://linked.art/example/object/okeeffe-yuag/1
(import std/base)
(import aat/identifier-type)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; One of two prints of a photograph, made from the same negative and showing the same image;
;; okeeffe-gok/1 is the other
(document object-okeeffe-yuag-1
  (-> (object "okeeffe-yuag/1" "GOK 1918, YUAG")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/photograph))
      (with :identified_by (array (base/identifier identifier-type/accession-number "2016.101.242")))
      (with :shows         ((:id (example "visual/okeeffe") :type "VisualItem" :_label "Visual Content of GOK 1918")))
      (with :produced_by   (:type                 "Production"
                            :_label               "Printing of Photograph"
                            :used_specific_object (array (object "okeeffe-negative" "Negative of GOK 1918"))))))
