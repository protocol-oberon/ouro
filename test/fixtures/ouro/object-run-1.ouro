;; linked.art's example, written in Ouro: https://linked.art/example/object/run/1
(import aat/object-type)
(import aat/technique)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

(define/procedure person #record (#string slug #string label)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

(define/procedure part #record (#record technique #record artist)
  (:type "Production" :technique (list technique) :carried_out_by (list artist)))

;; A work of two artists, each with a technique of their own: the making has a part for each
(graph object-run-1
  (-> (object "run/1" "RUN")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (list object-type/painting))
      (with :produced_by   (:type "Production"
                            :part (list (part technique/painting-technique (person "barrow" "Mark Barrow"))
                                        (part technique/hand-weaving (person "parke" "Sarah Parke")))))))
