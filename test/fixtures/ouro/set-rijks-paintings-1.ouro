;; linked.art's example, written in Ouro: https://linked.art/example/set/rijks_paintings/1
(import std/base)
(import std/vocab)
(import aat/activity-type)
(import aat/set-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure set #record (#string slug #string label)
  (:id (example (+ "set/" slug)) :type "Set" :_label label))

;; A collection within a collection, curated by a department
(document set-rijks-paintings-1
  (-> (set "rijks_paintings/1" "Paintings of the Rijksmuseum")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array set-type/collection))
      (with :identified_by (array (base/name vocab/primary-name "Paintings of the Rijksmuseum")))
      (with :member_of     (array (set "rijks_objects" "Collection of the Rijksmuseum")))
      (with :used_for      ((:type           "Activity"
                             :classified_as  (array activity-type/curating)
                             :carried_out_by ((:id (example "group/rijks_paintings_dept") :type "Group" :_label "Paintings Department")))))))
