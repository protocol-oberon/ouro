;; linked.art's example, written in Ouro: https://linked.art/example/person/0
(import std/actor)
(import std/base)
(import std/time)
(import aat/gender)
(import aat/nationality)
(import aat/statement-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure person ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

(define/procedure place ⊢ record (<label ⊢ string>)
  (:type "Place" :_label label))

;; Born and died over a day, from midnight to midnight, at a place
(define/procedure life-event ⊢ record (<type ⊢ string> <label ⊢ string> <day ⊢ date> <where ⊢ string>)
  (:type          type
   :_label        label
   :timespan      (time/span day (+ day (days 1)))
   :took_place_at (array (place where))))

;; A person's life: gender and nationality, birth and death, working life, home and address
(document person-0
  (-> (person "0" "Rembrandt")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as  (array gender/male nationality/dutch))
      (with :identified_by  ((:type "Name" :content "Rembrandt Harmenszoon van Rijn")))
      (with :referred_to_by (array (base/statement statement-type/biography-statement "Rembrandt was a Dutch draughtsman, painter and printmaker.")))
      (with :born           (life-event "Birth" "Birth of Rembrandt" <"1606-07-15T00:00:00Z" ⊢ date> "Leiden"))
      (with :died           (life-event "Death" "Death of Rembrandt" <"1669-10-04T00:00:00Z" ⊢ date> "Amsterdam"))
      (with :carried_out    (array (-> (actor/active (time/span <"1631-01-01T00:00:00Z" ⊢ date> <"1669-10-05T00:00:00Z" ⊢ date>))
                                      (with :_label        "Active Dates")
                                      (with :took_place_at (array (place "Amsterdam"))))))
      (with :residence      (array (place "Nieuwe Doelenstraat")))
      (with :contact_point  (array (actor/street-address "Jodenbreestraat 4, 1011NK Amsterdam")))
      (with :equivalent     (array (base/ulan "500011051" "Person" "Rembrandt")))))
