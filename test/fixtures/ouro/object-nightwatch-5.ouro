;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/5
(import std/time)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; Made in Amsterdam in 1642, by Rembrandt
(document object-nightwatch-5
  (-> (object "nightwatch/5" "Night Watch by Rembrandt")
      (with :context     "https://linked.art/ns/v1/linked-art.json")
      (with :produced_by (:type           "Production"
                          :timespan       (with (time/year "1642") :_label "1642")
                          :took_place_at  ((:id (example "place/amsterdam") :type "Place" :_label "Amsterdam"))
                          :carried_out_by ((:id (example "person/rembrandt") :type "Person" :_label "Rembrandt"))))))
