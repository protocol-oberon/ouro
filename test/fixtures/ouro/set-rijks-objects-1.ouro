;; linked.art's example, written in Ouro: https://linked.art/example/set/rijks_objects/1
(import std/base)
(import std/vocab)
(import aat/set-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure set #record (#string slug #string label)
  (:id (example (+ "set/" slug)) :type "Set" :_label label))

(document set-rijks-objects-1
  (-> (set "rijks_objects/1" "Collection of the Rijksmuseum")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array set-type/collection))
      (with :identified_by (array (base/name vocab/primary-name "Collection of the Rijksmuseum")))))
