;; linked.art's example, written in Ouro: https://linked.art/example/object/8
(import std/base)
(import std/object)
(import std/vocab)
(import aat/activity-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

;; An uncertain height: a value with an upper and a lower limit, how it is shown, and who
;; measured it. linked.art gives the object no label.
(document object-8
  (:context  "https://linked.art/ns/v1/linked-art.json"
   :id       (example "object/8")
   :type     "HumanMadeObject"
   :dimension (array (-> (object/height 24 object/inches)
                         (with :upper_value_limit 26)
                         (with :lower_value_limit 22)
                         (with :identified_by     (array (base/name vocab/display-name "24 inches high (+/- 2 inches)")))
                         (with :assigned_by       ((:type           "AttributeAssignment"
                                                    :classified_as  (array activity-type/measuring)
                                                    :carried_out_by ((:type "Person" :_label "Curator")))))))))
