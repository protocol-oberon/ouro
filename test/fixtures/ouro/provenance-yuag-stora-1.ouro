;; linked.art's example, written in Ouro: https://linked.art/example/provenance/yuag_stora/1
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure provenance #record (#string slug #string label)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (list vocab/provenance-activity)))

(define/procedure node #record (#string path #string type #string label)
  (:id (example path) :type type :_label label))

(define/constant feigen (node "group/feigen" "Group" "Richard Feigen Gallery"))
(define/constant yuag   (node "group/yuag" "Group" "Yale University Art Gallery"))

;; An exchange: two objects, each passing between the same two owners
(graph provenance-yuag-stora-1
  (-> (provenance "yuag_stora/1" "Exchange of Objects")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    ((:type                   "Acquisition"
                       :_label                 "Acquisition of Personnages"
                       :transferred_title_of   (list (node "object/masson_personnages" "HumanMadeObject" "Personnages dans un parc")
                                                     (node "object/beckmann_nude" "HumanMadeObject" "Nude Woman by Beckmann"))
                       :transferred_title_from (list feigen yuag)
                       :transferred_title_to   (list yuag feigen))
                      (:type "Acquisition" :_label "Acquisition of Nude")))))
