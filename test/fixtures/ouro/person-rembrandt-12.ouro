;; linked.art's example, written in Ouro: https://linked.art/example/person/rembrandt/12
(import std/actor)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure person ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

(document person-rembrandt-12
  (-> (person "rembrandt/12" "Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :contact_point (array (actor/street-address "Jodenbreestraat 4, 1011 NK Amsterdam")))))
