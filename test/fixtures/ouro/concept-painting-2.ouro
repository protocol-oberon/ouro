;; linked.art's example, written in Ouro: https://linked.art/example/concept/painting/2
(import std/base)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure concept #record (#string slug #string label)
  (:id (example (+ "concept/" slug)) :type "Type" :_label label))

;; A local copy of a Getty term, equivalent to it
(graph concept-painting-2
  (-> (concept "painting/2" "Local Copy of Painting")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (list (base/name vocab/primary-name "Painting")))
      (with :equivalent    (list (base/aat "300033618" "Painting")))))
