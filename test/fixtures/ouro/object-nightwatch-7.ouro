;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/7
(import std/object)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A painting's dimensions, as a statement
(document object-nightwatch-7
  (-> (object "nightwatch/7" "Night Watch by Rembrandt")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as  (array object-type/painting))
      (with :referred_to_by (array (object/dimension-statement "height 379.5 cm × width 453.5 cm × weight 337 kg")))))
