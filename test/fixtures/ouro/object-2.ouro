;; linked.art's example, written in Ouro: https://linked.art/example/object/2
(import std/base)
(import aat/material)
(import aat/object-type)
(import aat/part-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A painting and a part of it, each with its own material
(graph object-2
  (-> (object "2" "Example Painting")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (list object-type/painting (base/aat "300133025" "Artwork")))
      (with :made_of       (list material/watercolor))
      (with :part          ((:type          "HumanMadeObject"
                             :_label        "Canvas Support"
                             :classified_as (list part-type/support)
                             :made_of       (list material/canvas))))))
