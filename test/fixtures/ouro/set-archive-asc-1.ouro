;; linked.art's example, written in Ouro: https://linked.art/example/set/archive_asc/1
(import std/base)
(import std/vocab)
(import aat/set-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure set #record (#string slug #string label)
  (:id (example (+ "set/" slug)) :type "Set" :_label label))

(document set-archive-asc-1
  (-> (set "archive_asc/1" "Alfred Stiegliz Correspondence")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array set-type/archival-grouping))
      (with :identified_by (array (base/name vocab/primary-name "Alfred Stiegliz Correspondence")))))
