;; linked.art's example, written in Ouro: https://linked.art/example/text/1
(import std/base)
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure text ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "text/" slug)) :type "LinguisticObject" :_label label))

;; A text's rights: in the public domain, classified by Creative Commons' own term
(document text-1
  (-> (text "1" "Example Text")
      (with :context    "https://linked.art/ns/v1/linked-art.json")
      (with :subject_to ((:type          "Right"
                          :_label        "Public Domain status of Example Text"
                          :classified_as ((:id <"https://creativecommons.org/publicdomain/zero/1.0/" ⊢ uri> :type "Type" :_label "cc0"))
                          :identified_by (array (base/name vocab/display-name "Public Domain")))))))
