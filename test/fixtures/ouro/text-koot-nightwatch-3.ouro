;; linked.art's example, written in Ouro: https://linked.art/example/text/koot_nightwatch/3
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure text #record (#string slug #string label)
  (:id (example (+ "text/" slug)) :type "LinguisticObject" :_label label))

(document text-koot-nightwatch-3
  (-> (text "koot_nightwatch/3" "Content of Koot's Night Watch")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/monograph))
      (with :about         ((:id (example "object/nightwatch") :type "HumanMadeObject" :_label "The Night Watch")))))
