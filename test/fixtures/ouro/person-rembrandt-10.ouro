;; linked.art's example, written in Ouro: https://linked.art/example/person/rembrandt/10
(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure person ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

;; A name and where it comes from: assigned by a book that uses it
(document person-rembrandt-10
  (-> (person "rembrandt/10" "Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by ((:type        "Name"
                             :content     "Rembrandt van Rijn"
                             :assigned_by ((:type                 "AttributeAssignment"
                                            :used_specific_object ((:id (example "text/gardner-art") :type "LinguisticObject" :_label "Art through the Ages")))))))))
