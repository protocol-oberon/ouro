;; linked.art's example, written in Ouro: https://linked.art/example/event/stowe/1
(import std/object)
(import std/time)
(import aat/activity-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure activity ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "event/" slug)) :type "Activity" :_label label))

;; Three days of auction, begun some day in the first twenty of August and ended some day in
;; the last three weeks of September
(document event-stowe-1
  (-> (activity "stowe/1" "Auction of Stowe House")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array activity-type/auction-event))
      (with :timespan      (with (time/between (time/day-range "1848-08-01" "1848-08-20")
                                               (time/day-range "1848-09-09" "1848-09-30"))
                            :identified_by ((:type "Name" :content "40 days in August and September, 1848"))
                            :duration      (:type "Dimension" :value 3 :unit object/day-unit)))))
