;; linked.art's example, written in Ouro: https://linked.art/example/event/christies_24477_16/1
(import std/base)
(import std/vocab)
(import aat/activity-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure activity #record (#string slug #string label)
  (:id (example (+ "event/" slug)) :type "Activity" :_label label))

;; One lot of an auction, part of the auction as a whole
(graph event-christies-24477-16-1
  (-> (activity "christies_24477_16/1" "Auction of Lot 16")
      (with :context              "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as        (array activity-type/auction-of-lot))
      (with :identified_by        (array (base/name vocab/primary-name "Auction of Lot 16")))
      (with :used_specific_object ((:id (example "set/24477_16_objects") :type "Set" :_label "Lot 16")))
      (with :part_of              ((:id (example "event/christies_24477") :type "Activity")))))
