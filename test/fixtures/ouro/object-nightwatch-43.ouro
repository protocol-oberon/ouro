;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/43
(import std/time)
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A span with a display name of its own, a record known by its id. linked.art ends the span in
;; 1842, kept here as it publishes it.
(document object-nightwatch-43
  (-> (object "nightwatch/43" "Night Watch by Rembrandt")
      (with :context     "https://linked.art/ns/v1/linked-art.json")
      (with :produced_by (:type     "Production"
                          :timespan (with (time/year-range "1642" "1842")
                                     :identified_by ((:id (example "Name/1642") :type "Name" :classified_as (array vocab/display-name))))))))
