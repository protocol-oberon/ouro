;; linked.art's example, written in Ouro: https://linked.art/example/text/catalog_24477/1
(import std/base)
(import std/vocab)
(import aat/object-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure text ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "text/" slug)) :type "LinguisticObject" :_label label))

;; An auction's catalog, about the auction
(document text-catalog-24477-1
  (-> (text "catalog_24477/1" "Auction Catalog")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/auction-catalog))
      (with :identified_by (array (base/name vocab/primary-name "Impressionist & Modern Evening Sale Catalog")))
      (with :about         ((:id (example "event/christies_24477") :type "Activity" :_label "Impressionist Sale")))))
