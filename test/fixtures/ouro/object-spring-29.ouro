;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/29
(import std/object)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; Measured unframed: each dimension with the technique of its measuring
(define/procedure unframed #record (#record dimension)
  (with dimension
   :assigned_by ((:type      "AttributeAssignment"
                  :_label    "Unframed Measuring"
                  :technique ((:id (example "concept/measuring_unframed") :type "Type" :_label "Unframed Measuring"))))))

(graph object-spring-29
  (-> (object "spring/29" "Spring")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/painting))
      (with :dimension     (array (unframed (object/height 74 object/centimeters))
                                  (unframed (object/width 51.5 object/centimeters))))))
