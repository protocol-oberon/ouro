;; linked.art's example, written in Ouro: https://linked.art/example/object/ccp/1
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A print, made by printing from a plate: the plate is an object of its own
(document object-ccp-1
  (-> (object "ccp/1" "Chaucer's Canterbury Pilgrims")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/print))
      (with :produced_by   (:type                 "Production"
                            :_label               "Printing from Plate"
                            :used_specific_object (array (object "ccp-plate" "Plate for CCP"))))))
