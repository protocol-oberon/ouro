;; linked.art's example, written in Ouro: https://linked.art/example/set/archive_sfl/1
(import std/base)
(import std/vocab)
(import aat/set-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure set #record (#string slug #string label)
  (:id (example (+ "set/" slug)) :type "Set" :_label label))

;; A grouping within an archival grouping, a member of it
(document set-archive-sfl-1
  (-> (set "archive_sfl/1" "Stieglitz Family Letters")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array set-type/archival-sub-grouping))
      (with :identified_by (array (base/name vocab/primary-name "Stieglitz Family Letters")))
      (with :member_of     (array (set "archive_asc" "Alfred Stiegliz Correspondence")))))
