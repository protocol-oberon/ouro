;; linked.art's example, written in Ouro: https://linked.art/example/provenance/manet_proust/1
(import std/base)
(import std/provenance)
(import std/time)
(import std/vocab)
(import aat/currency)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure provenance #record (#string slug #string label)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(define/procedure node #record (#string path #string type #string label)
  (:id (example path) :type type :_label label))

(define/constant spring (node "object/spring" "HumanMadeObject" "Spring"))
(define/constant manet  (node "person/manet" "Person" "Manet"))
(define/constant proust (node "person/proust" "Person" "Proust"))

;; Proust buys Spring from Manet: title one way, three thousand francs the other
(document provenance-manet-proust-1
  (-> (provenance "manet_proust/1" "Purchase of Spring by Proust")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (array (base/name vocab/primary-name "Purchase of Spring by Proust from Manet")))
      (with :timespan      (time/year-range "1881" "1883"))
      (with :part          (array (with (provenance/acquisition spring manet proust) :_label "Ownership of Spring to Proust")
                                  (with (provenance/payment (provenance/money 3000 currency/french-francs) proust manet)
                                  :_label "3000 Francs to Manet")))))
