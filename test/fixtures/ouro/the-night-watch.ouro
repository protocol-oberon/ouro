(:context "https://linked.art/ns/v1/linked-art.json"
 (define
   :linked-art    "https://linked.art/example/"
   :piece-started #date "1642-01-01T00:00:00Z")

 :id          #uri (+ linked-art "object/nightwatch/5")
 :type        "HumanMadeObject"
 :_label      "Night Watch by Rembrandt"
 :produced_by (:type "Production"
               :timespan       (:type               "TimeSpan"
                                :_label             "1642"
                                :begin_of_the_begin piece-started
                                :end_of_the_end     (+ piece-started (days 364) (hours 23) (minutes 59) (seconds 59)))

               :took_place_at  ((:id     #uri (+ linked-art "place/amsterdam")
                                :type   "Place"
                                :_label "Amsterdam"))

               :carried_out_by ((:id     #uri (+ linked-art "person/rembrandt")
                                :type   "Person"
                                :_label "Rembrandt"))))
