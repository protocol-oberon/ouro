(import std/time)

(graph the-night-watch
 (let ($linked-art "https://linked.art/example/"

       ;; A local function is a fn bound by let; it closes over linked-art
       $node       (fn #rec (#str path #str type #str label)
                     (:id     #uri (+ linked-art path)
                      :type   type
                      :_label label)))

  (with (node "object/nightwatch/5" "HumanMadeObject" "Night Watch by Rembrandt")
   :context     "https://linked.art/ns/v1/linked-art.json"

   :produced_by (:type           "Production"
                 ;; The year from std/time, with Linked Art's _label written before it
                 :timespan       (:type "TimeSpan" :_label "1642" (inlay (time/year "1642")))

                 :took_place_at  ((node "place/amsterdam"   "Place"  "Amsterdam"))
                 :carried_out_by ((node "person/rembrandt"  "Person" "Rembrandt"))))))
