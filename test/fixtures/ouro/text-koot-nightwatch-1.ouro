;; linked.art's example, written in Ouro: https://linked.art/example/text/koot_nightwatch/1
(import std/base)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure text #record (#string slug #string label)
  (:id (example (+ "text/" slug)) :type "LinguisticObject" :_label label))

;; A book's content, part of its author's idea of it
(graph text-koot-nightwatch-1
  (-> (text "koot_nightwatch/1" "Content of Koot's Night Watch")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (list (base/name vocab/primary-name "Rembrant's Night Watch. A Fascinating Story")))
      (with :part_of       ((:id (example "concept/koot_idea") :type "PropositionalObject" :_label "Koot's Conceptualization")))))
