;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/21
(import std/time)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A material, assigned in a year: which property was assigned, and its value. linked.art
;; gives the canvas no label.
(document object-spring-21
  (-> (object "spring/21" "Spring")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/painting))
      (with :attributed_by ((:type              "AttributeAssignment"
                             :timespan          (time/year "2015")
                             :assigned_property "made_of"
                             :assigned          ((:id #uri "http://vocab.getty.edu/aat/300014078" :type "Material")))))))
