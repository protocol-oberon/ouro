;; linked.art's example, written in Ouro: https://linked.art/example/set/24477_16_objects/2
(import std/provenance)
(import aat/currency/iso)
(import aat/price-type)
(import aat/set-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure set #record (#string slug #string label)
  (:id (example (+ "set/" slug)) :type "Set" :_label label))

;; An auction lot's estimate, as a dimension of the lot
(graph set-24477-16-objects-2
  (-> (set "24477_16_objects/2" "Set of Objects for Lot 16")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (list set-type/auction-lot))
      (with :dimension     (list (with (provenance/money 25000000 iso/us-dollars)
                                  :classified_as (list price-type/estimated-price))))))
