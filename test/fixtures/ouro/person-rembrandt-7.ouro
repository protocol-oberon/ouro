;; linked.art's example, written in Ouro: https://linked.art/example/person/rembrandt/7
(import std/actor)
(import std/base)
(import std/time)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure person ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

;; A working life as a painter: Painter classifies the activity, so it is a plain Type here,
;; not aat/occupation's, which is classified Occupation
(document person-rembrandt-7
  (-> (person "rembrandt/7" "Rembrandt")
      (with :context     "https://linked.art/ns/v1/linked-art.json")
      (with :carried_out (array (adjoin (actor/active (time/day-range "1631-01-01" "1669-10-04"))
                                :classified_as (base/aat "300025136" "Painter"))))))
