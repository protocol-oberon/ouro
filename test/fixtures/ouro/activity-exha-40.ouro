;; linked.art's example, written in Ouro: https://linked.art/example/activity/exha/40
(import std/exhibition)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(document activity-exha-40
  (with (exhibition/exhibiting (example "activity/exha/40") "Manet and Modern Beauty (Getty)")
   :context "https://linked.art/ns/v1/linked-art.json"))
