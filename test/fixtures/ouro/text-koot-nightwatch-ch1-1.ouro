;; linked.art's example, written in Ouro: https://linked.art/example/text/koot_nightwatch_ch1/1
(import std/base)
(import std/vocab)
(import aat/object-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure text ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "text/" slug)) :type "LinguisticObject" :_label label))

;; A chapter, part of its book
(document text-koot-nightwatch-ch1-1
  (-> (text "koot_nightwatch_ch1/1" "Chapter 1 of Koot")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/chapter))
      (with :identified_by (array (base/name vocab/primary-name "Introduction")))
      (with :part_of       (array (text "koot_nightwatch" "Koot's Night Watch")))))
