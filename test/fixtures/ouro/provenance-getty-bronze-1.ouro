;; linked.art's example, written in Ouro: https://linked.art/example/provenance/getty_bronze/1
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure provenance #record (#string slug #string label)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(define/procedure node #record (#string path #string type #string label)
  (:id (example path) :type type :_label label))

(define/constant youth  (node "object/victorious_youth" "HumanMadeObject" "Victorious Youth"))
(define/constant finder (node "group/ferruccio" "Group" "Owners of Ferri Ferruccio"))

;; A find: the object is encountered, and its finders take title of it from no one
(document provenance-getty-bronze-1
  (-> (provenance "getty_bronze/1" "Discovery of Victorious Youth")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    ((:type "Encounter" :_label "Encounter of Sculpture" :carried_out_by (array finder) :encountered (array youth))
                      (:type "Acquisition" :transferred_title_of (array youth) :transferred_title_to (array finder))))))
