;; linked.art's example, written in Ouro: https://linked.art/example/concept/historyFrance/1
(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure concept ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "concept/" slug)) :type "Type" :_label label))

(document concept-historyfrance-1
  (-> (concept "historyFrance/1" "History of France")
      (with :context    "https://linked.art/ns/v1/linked-art.json")
      (with :created_by (:type          "Creation"
                         :influenced_by (array (concept "history" "History")
                                               (:id (example "place/france") :type "Place" :_label "France"))))))
