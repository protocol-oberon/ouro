;; linked.art's example, written in Ouro: https://linked.art/example/provenance/yuag_ycba_wiley/1
(import std/time)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure provenance #record (#string slug #string label)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(define/procedure node #record (#string path #string type #string label)
  (:id (example path) :type type :_label label))

;; A joint purchase: title passes to two museums together
(document provenance-yuag-ycba-wiley-1
  (-> (provenance "yuag_ycba_wiley/1" "Purchase of Painting")
      (with :context  "https://linked.art/ns/v1/linked-art.json")
      (with :timespan (time/year "2021"))
      (with :part     ((:type                 "Acquisition"
                        :transferred_title_of (array (node "object/yiadom-boakye" "HumanMadeObject" "Portrait of Lynette Yiadom-Boakye"))
                        :transferred_title_to (array (node "group/yuag" "Group" "Yale University Art Gallery")
                                                     (node "group/ycba" "Group" "Yale Center for British Art")))))))
