;; linked.art's example, written in Ouro: https://linked.art/example/person/rembrandt/42
(import std/base)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure person #record (#string slug #string label)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

;; A value to sort by, never shown
(graph person-rembrandt-42
  (-> (person "rembrandt/42" "Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (array (base/identifier vocab/sort-value "r0000011")))))
