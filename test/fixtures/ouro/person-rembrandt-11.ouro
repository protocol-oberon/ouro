;; linked.art's example, written in Ouro: https://linked.art/example/person/rembrandt/11
(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure person ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

(document person-rembrandt-11
  (-> (person "rembrandt/11" "Rembrandt")
      (with :context   "https://linked.art/ns/v1/linked-art.json")
      (with :residence ((:id (example "place/rembrandthuis") :type "Place" :_label "Rembrandt's House Place")))))
