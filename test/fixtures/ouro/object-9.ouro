;; linked.art's example, written in Ouro: https://linked.art/example/object/9
(import std/base)
(import std/time)
(import std/vocab)
(import aat/identifier-type)
(import aat/statement-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

;; An identifier with a history: named, annotated, and assigned by a museum in a year, which
;; linked.art ends at midnight, so the span is written out. linked.art gives the object no label.
(graph object-9
  (:context       "https://linked.art/ns/v1/linked-art.json"
   :id            (example "object/9")
   :type          "HumanMadeObject"
   :identified_by (list (-> (base/identifier identifier-type/accession-number "1997-A1752")
                            (with :_label         "Example Museum Accession Number")
                            (with :identified_by  (list (base/name vocab/primary-name "Accession Number")))
                            (with :referred_to_by (list (base/statement statement-type/note "This is the original accession number from 1997")))
                            (with :assigned_by    ((:type           "AttributeAssignment"
                                                    :_label         "Assignment of 1997-A1752"
                                                    :timespan       (with (time/span "1997-01-01T00:00:00Z" "1997-12-31T00:00:00Z") :_label "1997")
                                                    :carried_out_by ((:type "Group" :_label "Example Museum")))))))))
