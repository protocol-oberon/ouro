;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/47
(import std/object)
(import std/vocab)
(import aat/unit)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A colour, as a dimension: its RGB value as a number
(document object-nightwatch-47
  (-> (object "nightwatch/47" "Night Watch by Rembrandt")
      (with :context   "https://linked.art/ns/v1/linked-art.json")
      (with :dimension (array (with (object/dimension vocab/color 11754015.0 unit/rgb) :_label "brown")))))
