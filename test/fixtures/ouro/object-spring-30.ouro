;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/30
(import std/base)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; Painting as a plain Type, not yet classified a type of work
(document object-spring-30
  (-> (object "spring/30" "Jeanne (Spring) by Manet")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array (base/aat "300033618" "Painting")))))
