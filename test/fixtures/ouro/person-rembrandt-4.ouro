;; linked.art's example, written in Ouro: https://linked.art/example/person/rembrandt/4
(import std/actor)
(import std/base)
(import std/vocab)
(import aat/name-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure person ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

;; A name in its parts; the middle name is a record of its own, known by its id
(document person-rembrandt-4
  (-> (person "rembrandt/4" "Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (array (with (base/name vocab/primary-name "Rembrandt Harmenzoon van Rijn")
                                   :part (array (actor/given-name "Rembrandt")
                                                (:id            (example "Name/Harmenzoon")
                                                 :type          "Name"
                                                 :classified_as (array name-type/middle-name))
                                                (actor/family-name "van Rijn")))))))
