;; linked.art's example, written in Ouro: https://linked.art/example/provenance/fixme/1
(import std/provenance)
(import std/vocab)
(import aat/currency)
(import aat/currency/iso)
(import aat/group-type)
(import aat/provenance-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure provenance #record (#string slug #string label)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (list vocab/provenance-activity)))

(define/constant buyer (:type "Person" :_label "Buyer"))

;; A purchase with a commission: one payment to the seller, another to the auction house.
;; linked.art gives the first amount's currency its notation and not the second's.
(graph provenance-fixme-1
  (-> (provenance "fixme/1" "Purchase of Sculpture with Commission")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    (list (provenance/payment (provenance/money 900 iso/us-dollars) buyer (:type "Person" :_label "Seller"))
                           (with (provenance/payment (provenance/money 100 currency/us-dollars)
                                                     buyer
                                                     (:type "Group" :_label "Auction House" :classified_as (list group-type/auction-house)))
                            :classified_as (list provenance-type/commissioning))))))
