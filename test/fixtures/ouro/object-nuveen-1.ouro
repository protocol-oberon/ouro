;; linked.art's example, written in Ouro: https://linked.art/example/object/nuveen/1
(import std/base)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A commissioned painting: its making was caused by the commission, an activity of its own
(graph object-nuveen-1
  (-> (object "nuveen/1" "Nuveen Painting")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (list (base/name vocab/primary-name "The Nuveen Painting")))
      (with :produced_by   (:type           "Production"
                            :carried_out_by ((:id (example "person/dine") :type "Person" :_label "Jim Dine"))
                            :caused_by      ((:id (example "event/nuveen_commission") :type "Activity" :_label "Commission"))))))
