;; linked.art's example, written in Ouro: https://linked.art/example/object/yiadom-boakye/1
(import std/base)
(import aat/group-type)
(import aat/identifier-type)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

(define/procedure accession #record (#string number #string museum #string label)
  (with (base/identifier identifier-type/accession-number number)
    :assigned_by ((:type           "AttributeAssignment"
                   :carried_out_by ((:id            (example (+ "group/" museum))
                                     :type          "Group"
                                     :_label        label
                                     :classified_as (array group-type/museum)))))))

;; A painting owned jointly by two museums, each giving it an accession number of its own
(graph object-yiadom-boakye-1
  (-> (object "yiadom-boakye/1" "Portrait of Lynette Yiadom-Boakye")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/painting))
      (with :identified_by (array (accession "2021.25.1" "yuag" "Yale University Art Gallery")
                                  (accession "B2021.5" "ycba" "Yale Center for British Art")))))
