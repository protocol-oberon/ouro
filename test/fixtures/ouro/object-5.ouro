;; linked.art's example, written in Ouro: https://linked.art/example/object/5
(import std/base)
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A related object, recommended by a curator: the assignment classified by a local term
(document object-5
  (-> (object "5" "Painting of a Fish")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :attributed_by ((:type           "AttributeAssignment"
                             :classified_as  ((:id <"http://example.org/types/recommending" ⊢ uri> :type "Type" :_label "Recommendation"))
                             :identified_by  (array (base/name vocab/display-name "Related Object: Another Painting of a Fish"))
                             :carried_out_by ((:id (example "person/1") :type "Person" :_label "Curator"))
                             :assigned       (array (object "6" "Another Painting of a Fish")))))))
