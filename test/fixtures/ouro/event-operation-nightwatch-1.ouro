;; linked.art's example, written in Ouro: https://linked.art/example/event/operation_nightwatch/1
(import std/base)
(import std/time)
(import std/vocab)
(import aat/activity-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure activity #record (#string slug #string label)
  (:id (example (+ "event/" slug)) :type "Activity" :_label label))

(define/procedure group #record (#string slug #string label)
  (:id (example (+ "group/" slug)) :type "Group" :_label label))

(document event-operation-nightwatch-1
  (-> (activity "operation_nightwatch/1" "Conservation Project")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as  (array activity-type/conservation-activity))
      (with :identified_by  (array (base/name vocab/primary-name "Operation Night Watch")))
      (with :referred_to_by (array (base/description "Operation Night Watch is the biggest and most wide-ranging ever study of Rembrandt’s most famous painting.")))
      (with :timespan       (time/year-range "2019" "2023"))
      (with :carried_out_by (array (group "rijksmuseum" "Rijksmuseum")
                                   (group "akzonobel" "AkzoNobel")))))
