;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/1
(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

(document object-spring-1
  (with (object "spring/1" "Jeanne (Spring) by Manet")
   :context "https://linked.art/ns/v1/linked-art.json"))
