;; linked.art's example, written in Ouro: https://linked.art/example/provenance/0
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

;; An event of provenance: an Activity classified as one, whatever its parts
(define/procedure provenance ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(document provenance-0
  (with (provenance "0" "Provenance Activity")
   :context "https://linked.art/ns/v1/linked-art.json"))
