;; linked.art's example, written in Ouro: https://linked.art/example/place/0
(import std/base)
(import aat/place-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure place ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "place/" slug)) :type "Place" :_label label))

(document place-0
  (-> (place "0" "Los Angeles")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as  (array place-type/city))
      (with :identified_by  ((:type "Name" :content "Los Angeles")
                             (:type "Identifier" :content "06-44000")))
      (with :defined_by     "POLYGON((-118.574 34.185,-117.558 34.185,-117.5585 33.512,-118.574 33.512,-118.5745 34.185))")
      (with :referred_to_by (array (base/description "Los Angeles is the largest city in California")))
      (with :part_of        ((:type "Place" :_label "California")))
      (with :member_of      ((:type "Set" :_label "Top 10 Cities in USA")))
      (with :equivalent     (array (base/tgn "7023900" "Los Angeles")))))
