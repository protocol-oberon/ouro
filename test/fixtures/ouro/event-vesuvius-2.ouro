;; linked.art's example, written in Ouro: https://linked.art/example/event/vesuvius/2
(import std/base)
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure event ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "event/" slug)) :type "Event" :_label label))

(document event-vesuvius-2
  (-> (event "vesuvius/2" "Eruption of Vesuvius")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (array (base/name vocab/primary-name "Eruption of Vesuvius")))
      (with :during        ((:id (example "event/early_roman") :type "Period" :_label "Early Roman Empire")))))
