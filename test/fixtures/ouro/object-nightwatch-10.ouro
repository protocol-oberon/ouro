;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/10
(import std/base)
(import std/object)
(import std/vocab)
(import aat/object-type)
(import aat/unit)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A colour, as a dimension: its RGB value as a number, named, and written as a hex code
(graph object-nightwatch-10
  (-> (object "nightwatch/10" "Night Watch by Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (list object-type/painting))
      (with :dimension     (list (-> (object/dimension vocab/color 11754015.0 unit/rgb)
                                     (with :_label        "brown")
                                     (adjoin :classified_as (base/aat "300127490" "Brown"))
                                     (with :identified_by ((:type "Identifier" :content "#B35A1F"))))))))
