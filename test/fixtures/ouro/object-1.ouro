;; linked.art's example, written in Ouro: https://linked.art/example/object/1
(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; Places with no ids: a gallery it is in, a city it was made in
(document object-1
  (-> (object "1" "Van Gogh Painting")
      (with :context          "https://linked.art/ns/v1/linked-art.json")
      (with :current_location (:type "Place" :_label "Rijksmuseum Gallery"))
      (with :produced_by      (:type          "Production"
                               :_label        "Production of Painting"
                               :took_place_at ((:type "Place" :_label "Amsterdam"))))))
