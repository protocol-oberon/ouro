;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/4
(import std/time)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; Made in France in 1881 by Manet, during the 19th century
(document object-spring-4
  (-> (object "spring/4" "Jeanne (Spring) by Manet")
      (with :context     "https://linked.art/ns/v1/linked-art.json")
      (with :produced_by (:type           "Production"
                          :timespan       (with (time/year "1881") :_label "1881")
                          :took_place_at  ((:id (example "place/france") :type "Place" :_label "France"))
                          :carried_out_by ((:id (example "person/manet") :type "Person" :_label "Manet"))
                          :during         ((:id (example "event/19c") :type "Period" :_label "19th Century"))))))
