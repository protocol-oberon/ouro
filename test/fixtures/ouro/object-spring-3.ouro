;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/3
(import std/base)
(import aat/object-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A painting, classified as a type of work as Linked Art requires, and an artwork
(document object-spring-3
  (-> (object "spring/3" "Jeanne (Spring) by Manet")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/painting (base/aat "300133025" "Artwork")))))
