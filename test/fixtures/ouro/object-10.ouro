;; linked.art's example, written in Ouro: https://linked.art/example/object/10
(import std/base)
(import std/vocab)
(import aat/language)
(import aat/language/iso)
(import aat/name-type)
(import aat/statement-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

;; A title in two languages, with its subtitle as a part; linked.art writes English without its
;; code in the subtitle, and gives the object no label
(document object-10
  (:context       "https://linked.art/ns/v1/linked-art.json"
   :id            (example "object/10")
   :type          "HumanMadeObject"
   :identified_by (array (-> (base/name vocab/primary-name "Hacha (Ceremonial Axe)")
                            (with :identified_by  (array (base/name vocab/display-name "Assigned Title")))
                            (with :referred_to_by (array (base/statement statement-type/note "Title was originally given as 'hacha'")))
                            (with :language       (array iso/spanish iso/english))
                            (with :part           (array (with (base/name name-type/subtitle "Ceremonial Axe")
                                                         :language (array language/english))))))))
