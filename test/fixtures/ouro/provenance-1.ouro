;; linked.art's example, written in Ouro: https://linked.art/example/provenance/1
(import std/base)
(import std/provenance)
(import std/time)
(import std/vocab)
(import aat/currency/iso)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure provenance ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

;; A museum's own records, at its own URIs
(define/procedure museum ⊢ record (<path ⊢ string> <type ⊢ string> <label ⊢ string>)
  (:id <(+ "http://example.museum/" path) ⊢ uri> :type type :_label label))

(define/constant st-george (museum "object/1" "HumanMadeObject" "St George and the Dragon"))
(define/constant simpson   (museum "person/2" "Person" "Simpson"))
(define/constant adams     (museum "person/1" "Person" "Adams"))

;; A purchase at auction: title from the seller to the buyer, money the other way
(document provenance-1
  (-> (provenance "1" "St George from Simpson to Adams")
      (with :context              "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by        ((:type "Name" :content "Purchase of Lot 0055a, Durer's St George and the Dragon")
                                   (:type "Identifier" :content "0055a")))
      (with :timespan             (with (time/day "1820-03-09") :_label "1820 Mar 09"))
      (with :took_place_at        (array (base/tgn "7011781" "London")))
      (with :carried_out_by       (array (base/ulan "500451765" "Group" "Edward Foster & Son")))
      (with :used_specific_object ((:id <"http://example.org/set/Br1908/0055" ⊢ uri> :type "Set" :_label "Set of Objects for Lot 0055")))
      (with :caused_by            ((:id <"http://example.org/auction/Br1908/0055" ⊢ uri> :type "Activity" :_label "Auction of Lot 0055")))
      (with :part                 (array (provenance/acquisition st-george simpson adams)
                                         (provenance/payment (with (provenance/money 8.8 iso/british-pounds) :_label "8.8 pounds")
                                                             adams simpson)))))
