;; linked.art's example, written in Ouro: https://linked.art/example/object/kellerdana/1
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A copy: its making was influenced by the portrait it copies
(graph object-kellerdana-1
  (-> (object "kellerdana/1" "Copy of Huntington Portrait")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/painting))
      (with :produced_by   (:type           "Production"
                            :carried_out_by ((:id (example "person/keller") :type "Person" :_label "Deane Keller"))
                            :influenced_by  (array (object "huntingtondana" "Huntington Portrait of Dana"))))))
