;; linked.art's example, written in Ouro: https://linked.art/example/object/7
(import std/base)
(import std/vocab)
(import aat/digital-type)
(import aat/language/iso)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

;; A home page about the object: an English text, carried by a named web page at a URL.
;; linked.art gives the object no label.
(graph object-7
  (:context       "https://linked.art/ns/v1/linked-art.json"
   :id            (example "object/7")
   :type          "HumanMadeObject"
   :identified_by (array (base/name vocab/primary-name "Object"))
   :subject_of    ((:type                 "LinguisticObject"
                    :language             (array iso/english)
                    :digitally_carried_by ((:type          "DigitalObject"
                                            :classified_as (array digital-type/web-page)
                                            :identified_by (array (base/name vocab/primary-name "Home page for Object"))
                                            :access_point  ((:id #uri "https://example.org/objects/1" :type "DigitalObject"))))))))
