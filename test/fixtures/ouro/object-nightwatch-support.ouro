;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/support
(import aat/material)
(import aat/part-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A part of a painting, as an object of its own: its canvas support
(document object-nightwatch-support
  (-> (object "nightwatch/support" "Support of Night Watch")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array part-type/support))
      (with :made_of       (array material/canvas))
      (with :part_of       (array (object "nightwatch" "Night Watch by Rembrandt")))))
