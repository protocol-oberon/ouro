;; linked.art's example, written in Ouro: https://linked.art/example/group/harwoodstudio/1
(import std/base)
(import aat/group-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure group #record (#string slug #string label)
  (:id (example (+ "group/" slug)) :type "Group" :_label label))

;; A studio, formed under the influence of its master
(graph group-harwoodstudio-1
  (-> (group "harwoodstudio/1" "Studio of Francis Harwood")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array group-type/studio))
      (with :formed_by     (:type          "Formation"
                            :influenced_by (array (base/ulan "500015886" "Person" "Francis Harwood"))))))
