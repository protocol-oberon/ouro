;; linked.art's example, written in Ouro: https://linked.art/example/provenance/spring_aic/1
(import std/vocab)
(import aat/provenance-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure provenance ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(define/procedure node ⊢ record (<path ⊢ string> <type ⊢ string> <label ⊢ string>)
  (:id (example path) :type type :_label label))

;; A loan: custody passes to the borrower for a while
(document provenance-spring-aic-1
  (-> (provenance "spring_aic/1" "Loan of Spring to AIC")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    ((:type                     "TransferOfCustody"
                       :classified_as            (array provenance-type/loan)
                       :transferred_custody_of   (array (node "object/spring" "HumanMadeObject" "Spring"))
                       :transferred_custody_from (array (node "group/getty" "Group" "Getty Museum"))
                       :transferred_custody_to   (array (node "group/aic" "Group" "Art Institute of Chicago")))))))
