;; linked.art's example, written in Ouro: https://linked.art/example/person/rembrandt/8
(import std/base)
(import aat/statement-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure person #record (#string slug #string label)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

(graph person-rembrandt-8
  (-> (person "rembrandt/8" "Rembrandt")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :referred_to_by (array (base/statement statement-type/biography-statement "Rembrandt's work is characterized by the Baroque interest in dramatic scenes and strong contrasts of light on a dark stage")))))
