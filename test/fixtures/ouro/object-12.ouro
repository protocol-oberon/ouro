;; linked.art's example, written in Ouro: https://linked.art/example/object/12
(import std/base)
(import std/vocab)
(import aat/language/iso)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

;; A description with its heading, its source, its language and its licence. linked.art gives
;; the object and the licence no label.
(document object-12
  (:context        "https://linked.art/ns/v1/linked-art.json"
   :id             (example "object/12")
   :type           "HumanMadeObject"
   :referred_to_by (array (-> (base/description "A small greenstone pendant surrounded by silver")
                             (with :identified_by  (array (base/name vocab/display-name "Description")))
                             (with :referred_to_by ((:type "LinguisticObject" :content "Description provided by the artist")))
                             (with :language       (array iso/english))
                             (with :subject_to     ((:type          "Right"
                                                     :classified_as ((:id <"https://creativecommons.org/licenses/by/4.0/" ⊢ uri> :type "Type"))
                                                     :identified_by (array (base/name vocab/display-name "CC BY 4.0")))))))))
