;; linked.art's example, written in Ouro: https://linked.art/example/concept/painting/1
(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure concept #record (#string slug #string label)
  (:id (example (+ "concept/" slug)) :type "Type" :_label label))

(document concept-painting-1
  (with (concept "painting/1" "Painting")
   :context "https://linked.art/ns/v1/linked-art.json"))
