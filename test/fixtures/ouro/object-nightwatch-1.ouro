;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/1
(import std/base)
(import std/vocab)
(import aat/language/iso)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A primary name in each of two languages
(define/procedure named #record (#string content #record language)
  (with (base/name vocab/primary-name content) :language (list language)))

(graph object-nightwatch-1
  (-> (object "nightwatch/1" "Night Watch by Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (list (named "The Night Watch" iso/english)
                                 (named "De Nachtwacht" iso/dutch)))))
