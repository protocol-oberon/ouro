;; linked.art's example, written in Ouro: https://linked.art/example/event/1
(import std/base)
(import std/object)
(import std/time)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

;; One day, some time around 1750: begun within one span and ended within another, with its
;; duration and the estimate it rests on
(document event-1
  (:context "https://linked.art/ns/v1/linked-art.json"
   :id       (example "event/1")
   :type     "Activity"
   :timespan (with (time/between (time/span <"1720-01-01T00:00:00Z" ⊢ date> <"1751-01-01T00:00:00Z" ⊢ date>)
                                 (time/span <"1749-01-01T00:00:00Z" ⊢ date> <"1780-01-01T00:00:00Z" ⊢ date>))
              :_label         "1 day, c. 1750"
              :identified_by  ((:type "Name" :content "1 day, during circa 1750"))
              :referred_to_by (array (base/description "About 1750, as estimated by C. U. Rata"))
              :duration       (:type "Dimension" :value 1 :unit object/day-unit))))
