;; linked.art's example, written in Ouro: https://linked.art/example/provenance/coffin_promise/1
(import std/base)
(import std/vocab)
(import aat/provenance-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure provenance #record (#string slug #string label)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(define/procedure node #record (#string path #string type #string label)
  (:id (example path) :type type :_label label))

;; A gift promised: the promise is the event, the gift still to come
(document provenance-coffin-promise-1
  (-> (provenance "coffin_promise/1" "Promised Gift of Coffin")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    ((:type                 "Activity"
                       :_label               "Promise of Gift"
                       :classified_as        (array provenance-type/promise)
                       :referred_to_by       (array (base/description "Promised gift of Thomas Jaffe, B.A. 1971"))
                       :carried_out_by       (array (node "person/jaffe" "Person" "Thomas Jaffe"))
                       :used_specific_object (array (node "object/coffin" "HumanMadeObject" "Coffin"))
                       :participant          (array (node "group/yuag" "Group" "Yale University Art Gallery")))))))
