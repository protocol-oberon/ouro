;; linked.art's example, written in Ouro: https://linked.art/example/set/exhset/2
(import std/base)
(import aat/object-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure set ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "set/" slug)) :type "Set" :_label label))

;; A set described by what its members have in common: paintings by Manet
(document set-exhset-2
  (-> (set "exhset/2" "Exhibition objects")
      (with :context                "https://linked.art/ns/v1/linked-art.json")
      (with :members_exemplified_by ((:type          "HumanMadeObject"
                                      :classified_as (array object-type/painting)
                                      :produced_by   (:type           "Production"
                                                      :carried_out_by (array (base/ulan "500010363" "Person" "Manet"))))))))
