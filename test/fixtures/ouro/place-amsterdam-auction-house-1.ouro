;; linked.art's example, written in Ouro: https://linked.art/example/place/amsterdam_auction_house/1
(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure place ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "place/" slug)) :type "Place" :_label label))

(document place-amsterdam-auction-house-1
  (-> (place "amsterdam_auction_house/1" "Christie's AMS")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by ((:type "Name" :content "Christie's Amsterdam Location")))
      (with :part_of       (array (place "amsterdam" "Amsterdam")))))
