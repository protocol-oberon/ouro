;; linked.art's example, written in Ouro: https://linked.art/example/text/rembrandtjaccuse/1
(import std/time)
(import aat/role-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure text #record (#string slug #string label)
  (:id (example (+ "text/" slug)) :type "LinguisticObject" :_label label))

(define/procedure person #record (#string slug #string label)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

;; A part of a creation, by the role of who carried it out
(define/procedure role #record (#record kind #record who)
  (:type "Creation" :classified_as (array kind) :carried_out_by (array who)))

;; A film's creation, in its parts: directed by one person, produced by another
(document text-rembrandtjaccuse-1
  (-> (text "rembrandtjaccuse/1" "Rembrandt's J'accuse")
      (with :context    "https://linked.art/ns/v1/linked-art.json")
      (with :created_by (:type     "Creation"
                         :timespan (with (time/year "2008") :_label "2008")
                         :part     (array (role role-type/director (person "greenaway" "Peter Greenaway"))
                                          (role role-type/producer (person "wolting" "Femke Wolting")))))))
