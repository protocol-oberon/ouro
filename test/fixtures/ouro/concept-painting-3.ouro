;; linked.art's example, written in Ouro: https://linked.art/example/concept/painting/3
(import std/base)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure concept #record (#string slug #string label)
  (:id (example (+ "concept/" slug)) :type "Type" :_label label))

;; A local copy of a Getty term, placed in the AAT's own hierarchy
(document concept-painting-3
  (-> (concept "painting/3" "Local Copy of Painting")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array vocab/type-of-work))
      (with :equivalent    (array (base/aat "300033618" "Painting")))
      (with :broader       (array (base/aat "300191086" "visual works")))))
