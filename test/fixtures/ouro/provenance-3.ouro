;; linked.art's example, written in Ouro: https://linked.art/example/provenance/3
(import std/vocab)
(import aat/object-type)
(import aat/right-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure provenance #record (#string slug #string label)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (list vocab/provenance-activity)))

(define/constant percent (:id #uri "http://qudt.org/3.0.0/vocab/unit/Percent" :type "MeasurementUnit" :_label "Percent"))

;; A share of ownership: a Right measured in percent, possessed by its owner
(define/procedure share #record (#string label #number part #string owner)
  (:type          "Right"
   :_label        label
   :classified_as (list right-type/ownership-right)
   :dimension     ((:type "Dimension" :value part :unit percent))
   :possessed_by  ((:type "Group" :_label owner))))

;; Two dealers buy a painting together: the whole right of ownership, in two shares
(graph provenance-3
  (-> (provenance "3" "Purchase of Painting by Two Dealers")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    ((:type        "RightAcquisition"
                       :establishes ((:type          "Right"
                                      :_label        "Total Right of Ownership"
                                      :classified_as (list right-type/ownership-right)
                                      :applies_to    ((:type "HumanMadeObject" :_label "Painting" :classified_as (list object-type/painting)))
                                      :part          (list (share "30% Ownership by Dealer 1" 30 "Dealer 1")
                                                           (share "70% Ownership by Dealer 2" 70 "Dealer 2")))))))))
