;; linked.art's example, written in Ouro: https://linked.art/example/place/amsterdam/1
(import std/base)
(import aat/place-type)

;; A project's own URIs stay in the project: std builds Linked Art's nodes, not their ids
(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure place #record (#string slug #string label)
  (:id (example (+ "place/" slug)) :type "Place" :_label label))

;; -> threads the place through its steps; with sets each property, a set written as an array
(document place-amsterdam-1
  (-> (place "amsterdam/1" "Amsterdam")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as  (array place-type/city))
      (with :identified_by  ((:type "Name" :content "Amsterdam")))
      (with :referred_to_by (array (base/description "Amsterdam is a city in the Netherlands")))
      (with :part_of        (array (-> (place "netherlands" "Netherlands")
                                      (with :classified_as (array place-type/country)))))))
