;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/15
(import std/base)
(import aat/statement-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

(graph object-nightwatch-15
  (-> (object "nightwatch/15" "Night Watch by Rembrandt")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :referred_to_by (array (base/statement statement-type/credit-line "On loan from the City of Amsterdam")))))
