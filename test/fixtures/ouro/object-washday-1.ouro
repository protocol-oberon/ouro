;; linked.art's example, written in Ouro: https://linked.art/example/object/washday/1
(import std/base)
(import std/vocab)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A painting in the manner of another artist: its making was influenced by him, a Person
(graph object-washday-1
  (-> (object "washday/1" "Wash Day")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (list object-type/painting))
      (with :identified_by (list (base/name vocab/primary-name "Wash Day")))
      (with :produced_by   (:type          "Production"
                            :influenced_by ((:id (example "person/whomer") :type "Person" :_label "Winslow Homer"))))))
