;; linked.art's example, written in Ouro: https://linked.art/example/place/new_zealand/1
(import aat/place-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure place #record (#string slug #string label)
  (:id (example (+ "place/" slug)) :type "Place" :_label label))

(graph place-new-zealand-1
  (-> (place "new_zealand/1" "New Zealand")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array place-type/country))
      (with :defined_by    "POLYGON((165.74 -33.55, -179.96 -33.55, -179.96 -47.8, 165.74 -47.8, 165.74 -33.55))")))
