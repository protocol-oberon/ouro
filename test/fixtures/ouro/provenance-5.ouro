;; linked.art's example, written in Ouro: https://linked.art/example/provenance/5
(import std/base)
(import std/vocab)
(import aat/object-type)
(import aat/right-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure provenance #record (#string slug #string label)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

;; A copyright established, for an association, in a painting
(graph provenance-5
  (-> (provenance "5" "Copyright acquisition by PCA")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    ((:type        "RightAcquisition"
                       :establishes ((:type          "Right"
                                      :classified_as (array right-type/copyright)
                                      :possessed_by  ((:type "Group" :_label "Paintings Copyright Association"))
                                      :applies_to    ((:type          "HumanMadeObject"
                                                       :_label        "Painting"
                                                       :classified_as (array object-type/painting (base/aat "300133025" "Artwork")))))))))))
