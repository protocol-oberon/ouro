;; linked.art's example, written in Ouro: https://linked.art/example/object/pompeii-buildings/1
(import std/base)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; The buildings of a city, destroyed by an eruption: the Destruction is caused by the Event.
;; linked.art gives the eruption no label here.
(graph object-pompeii-buildings-1
  (-> (object "pompeii-buildings/1" "Buildings making up the city of Pompeii")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (list (base/name vocab/primary-name "City of Pompeii")))
      (with :destroyed_by  (:type "Destruction" :caused_by ((:id (example "event/vesuvius") :type "Event"))))))
