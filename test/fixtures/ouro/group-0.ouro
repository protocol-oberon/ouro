;; linked.art's example, written in Ouro: https://linked.art/example/group/0
(import std/base)
(import std/time)
(import aat/language)
(import aat/nationality)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure group #record (#string slug #string label)
  (:id (example (+ "group/" slug)) :type "Group" :_label label))

;; Terms linked.art uses that aat does not recommend, or labels its own way
(define/constant society          (base/aat "300026009" "Society"))
(define/constant biography        (base/statement-kind "300435422" "Biography Statement"))
(define/constant active-dates     (base/aat "300393177" "Professional Activities"))

;; Formed and dissolved in London, in a year each
(define/procedure event #record (#string type #string label #string year)
  (:type          type
   :_label        label
   :timespan      (with (time/year year) :_label year)
   :took_place_at ((:type "Place" :_label "London"))))

(graph group-0
  (-> (group "0" "Camden Town Group")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as  (list society nationality/british))
      (with :identified_by  ((:type "Name" :content "Camden Town Group" :language (list language/english))))
      (with :referred_to_by (list (base/statement biography "A group of British painters formed in 1911; although it only lasted two years, its name is used in a broader sense to characterize a particular strain of British painting from about 1905 to 1920.")))
      (with :carried_out    ((:type          "Activity"
                              :_label        "Active Dates"
                              :classified_as (list active-dates)
                              :timespan      (time/year-range "1911" "1913"))))
      (with :formed_by      (event "Formation" "Formation of the Group" "1911"))
      (with :dissolved_by   (event "Dissolution" "Dissolution of the Group" "1913"))
      (with :residence      ((:type "Place" :_label "London")))
      (with :equivalent     (list (base/ulan "500117318" "Group" "Camden Town Group")))
      (with :attributed_by  ((:type     "AttributeAssignment"
                              :_label   "Related Group"
                              :assigned (list (base/ulan "500117319" "Group" "London Group")))))))
