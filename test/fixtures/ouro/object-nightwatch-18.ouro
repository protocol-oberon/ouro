;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/18
(import std/base)
(import aat/statement-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

;; A signature, transcribed; linked.art gives this record no label
(graph object-nightwatch-18
  (:context        "https://linked.art/ns/v1/linked-art.json"
   :id             (example "object/nightwatch/18")
   :type           "HumanMadeObject"
   :referred_to_by (list (base/statement statement-type/signature-statement "signature and date: ‘Rembrandt f 1642’"))))
