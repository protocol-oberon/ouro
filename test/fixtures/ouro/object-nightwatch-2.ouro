;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/2
(import std/base)
(import std/vocab)
(import aat/identifier-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

(graph object-nightwatch-2
  (-> (object "nightwatch/2" "Night Watch by Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (list (base/identifier identifier-type/accession-number "SK-C-5")
                                 (base/name vocab/primary-name "The Night Watch")))))
