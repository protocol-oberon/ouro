;; linked.art's example, written in Ouro: https://linked.art/example/provenance/payneheirs_getty/1
(import std/provenance)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure provenance #record (#string slug #string label)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(define/procedure node #record (#string path #string type #string label)
  (:id (example path) :type type :_label label))

;; A purchase through an agent, who carries out the acquisition for the buyer
(graph provenance-payneheirs-getty-1
  (-> (provenance "payneheirs_getty/1" "Purchase of Spring for Getty")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    (array (-> (provenance/acquisition (node "object/spring" "HumanMadeObject" "Spring")
                                                       (node "group/payne_heirs" "Group" "Family of Oliver Payne")
                                                       (node "group/getty" "Group" "J. Paul Getty Museum"))
                               (with :_label         "Acquisition of Spring")
                               (with :carried_out_by (array (node "person/naumann" "Person" "Otto Naumann"))))))))
