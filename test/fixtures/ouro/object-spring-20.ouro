;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/20
(import std/base)
(import std/vocab)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A member of an auction lot
(graph object-spring-20
  (-> (object "spring/20" "Spring")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/painting))
      (with :identified_by (array (base/name vocab/primary-name "Jeanne (Spring)")))
      (with :member_of     ((:id (example "set/24477_16_objects") :type "Set" :_label "Lot 16: Le Printemps")))))
