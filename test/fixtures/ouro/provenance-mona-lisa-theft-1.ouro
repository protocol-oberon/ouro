;; linked.art's example, written in Ouro: https://linked.art/example/provenance/mona_lisa_theft/1
(import std/vocab)
(import aat/provenance-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure provenance #record (#string slug #string label)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(define/procedure node #record (#string path #string type #string label)
  (:id (example path) :type type :_label label))

;; A theft moves custody, never title
(graph provenance-mona-lisa-theft-1
  (-> (provenance "mona_lisa_theft/1" "Theft of Mona Lisa")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    ((:type                     "TransferOfCustody"
                       :classified_as            (array provenance-type/theft)
                       :transferred_custody_of   (array (node "object/monalisa" "HumanMadeObject" "Mona Lisa"))
                       :transferred_custody_from (array (node "group/louvre" "Group" "Louvre"))
                       :transferred_custody_to   (array (node "person/peruggia" "Person" "Vincenzo Peruggia")))))))
