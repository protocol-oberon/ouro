;; linked.art's example, written in Ouro: https://linked.art/example/provenance/wiley_move/1
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure provenance ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "provenance/" slug)) :type "Activity" :_label label :classified_as (array vocab/provenance-activity)))

(define/procedure node ⊢ record (<path ⊢ string> <type ⊢ string> <label ⊢ string>)
  (:id (example path) :type type :_label label))

;; A move from one gallery to another: no title or custody passes
(document provenance-wiley-move-1
  (-> (provenance "wiley_move/1" "Movement of Wiley Painting")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :part    ((:type       "Move"
                       :moved      (array (node "object/yiadom-boakye" "HumanMadeObject" "Portrait of Lynette Yiadom-Boakye"))
                       :moved_from (node "place/ycba_gallery" "Place" "YCBA Gallery")
                       :moved_to   (node "place/yuag_gallery" "Place" "YUAG Gallery"))))))
