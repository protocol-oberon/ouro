;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/42
(import std/base)
(import std/object)
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A statement with the heading it is shown under
(document object-nightwatch-42
  (-> (object "nightwatch/42" "Night Watch by Rembrandt")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :referred_to_by (array (with (object/material-statement "Oil on Canvas")
                                   :identified_by (array (base/name vocab/display-name "Materials")))))))
