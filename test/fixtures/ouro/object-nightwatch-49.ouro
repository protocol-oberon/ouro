;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/49
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; An item of a cultural heritage collection, as Linked Art requires one be classified
(document object-nightwatch-49
  (-> (object "nightwatch/49" "Night Watch by Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array vocab/collection-item))))
