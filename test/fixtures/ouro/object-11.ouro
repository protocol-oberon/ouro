;; linked.art's example, written in Ouro: https://linked.art/example/object/11
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; An object's relations, each to a record known only by its label
(graph object-11
  (-> (object "11" "Example Painting")
      (with :context          "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as    (list object-type/painting))
      (with :referred_to_by   ((:type "LinguisticObject" :_label "Article about Painting")))
      (with :member_of        ((:type "Set" :_label "Museum Collection")))
      (with :shows            ((:type "VisualItem" :_label "Visual Work of Example Painting")))
      (with :current_owner    ((:type "Person" :_label "Owner")))
      (with :current_location (:type "Place" :_label "Gallery"))))
