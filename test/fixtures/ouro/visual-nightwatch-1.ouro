;; linked.art's example, written in Ouro: https://linked.art/example/visual/nightwatch/1
(import std/base)
(import aat/statement-type)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure visual ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "visual/" slug)) :type "VisualItem" :_label label))

;; An image's rights, as a statement
(document visual-nightwatch-1
  (-> (visual "nightwatch/1" "Visual Content of Night Watch")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :referred_to_by (array (base/statement statement-type/rights-statement "Public Domain")))))
