;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/16
(import std/base)
(import std/vocab)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A member of a museum's set of paintings
(graph object-nightwatch-16
  (-> (object "nightwatch/16" "Night Watch by Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as (array object-type/painting))
      (with :identified_by (array (base/name vocab/primary-name "The Night Watch")))
      (with :member_of     ((:id (example "set/rijks_paintings") :type "Set" :_label "Paintings of the Rijksmuseum")))))
