;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/5
(import std/base)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; A description, and what the painting shows
(document object-spring-5
  (-> (object "spring/5" "Jeanne (Spring) by Manet")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :referred_to_by (array (base/description "A chic young woman in a day dress with floral accents holds a parasol against a background of exuberant foliage.")))
      (with :shows          ((:id (example "visual/spring") :type "VisualItem" :_label "Visual Content of Spring")))))
