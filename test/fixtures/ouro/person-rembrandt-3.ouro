;; linked.art's example, written in Ouro: https://linked.art/example/person/rembrandt/3
(import std/base)
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure person ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

(document person-rembrandt-3
  (-> (person "rembrandt/3" "Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (array (base/name vocab/primary-name "Rembrandt Harmenzoon van Rijn")))))
