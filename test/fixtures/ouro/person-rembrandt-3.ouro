;; linked.art's example, written in Ouro: https://linked.art/example/person/rembrandt/3
(import std/base)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure person #record (#string slug #string label)
  (:id (example (+ "person/" slug)) :type "Person" :_label label))

(graph person-rembrandt-3
  (-> (person "rembrandt/3" "Rembrandt")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (list (base/name vocab/primary-name "Rembrandt Harmenzoon van Rijn")))))
