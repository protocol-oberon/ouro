;; linked.art's example, written in Ouro: https://linked.art/example/object/nightwatch/17
(import std/base)
(import aat/object-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; On loan: kept for now by one museum, permanently by another
(graph object-nightwatch-17
  (-> (object "nightwatch/17" "Painting")
      (with :context                     "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as               (array object-type/painting (base/aat "300133025" "Artwork")))
      (with :current_owner               ((:id (example "group/amsterdam_govt") :type "Group" :_label "City of Amsterdam Governing Body")))
      (with :current_permanent_custodian (base/ulan "500246547" "Group" "Rijksmuseum"))
      (with :current_custodian           (array (base/ulan "500115988" "Group" "Getty Museum")))))
