;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/back
(import std/base)
(import aat/part-type)
(import aat/statement-type)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; The back of the painting, as a part of its own, with what is inscribed on it
(document object-spring-back
  (-> (object "spring/back" "Back of Spring by Manet")
      (with :context        "https://linked.art/ns/v1/linked-art.json")
      (with :classified_as  (array part-type/back-part))
      (with :referred_to_by (array (base/statement statement-type/inscription-statement "11505F")))
      (with :part_of        (array (object "spring" "Jeanne (Spring) by Manet")))))
