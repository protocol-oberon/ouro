;; linked.art's example, written in Ouro: https://linked.art/example/object/spring/15
(import std/time)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure object ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

(define/procedure node ⊢ record (<path ⊢ string> <type ⊢ string> <label ⊢ string>)
  (:id (example path) :type type :_label label))

;; A change of ownership, seen from the object: from whom, to whom, when, and in which provenance event
(define/procedure owned ⊢ record (<label ⊢ string> <span ⊢ record> <event ⊢ string> <from ⊢ record> <to ⊢ record>)
  (:type                   "Acquisition"
   :_label                 label
   :timespan               span
   :part_of                (array (node (+ "event/" event) "Activity" "Full Provenance Activity"))
   :transferred_title_from (array from)
   :transferred_title_to   (array to)))

(document object-spring-15
  (-> (object "spring/15" "Jeanne (Spring) by Manet")
      (with :context                   "https://linked.art/ns/v1/linked-art.json")
      (with :changed_ownership_through (array (owned "Ownership of Spring to Proust" (time/year-range "1881" "1883") "manet_proust"
                                                     (node "person/manet" "Person" "Manet")
                                                     (node "person/proust" "Person" "Proust"))
                                              (owned "Ownership of Spring to Payne" (time/year "1909") "durand_payne"
                                                     (node "person/durand" "Person" "Durand-Ruel Gallery")
                                                     (node "person/payne" "Person" "Oliver Payne"))))))
