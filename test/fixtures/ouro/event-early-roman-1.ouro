;; linked.art's example, written in Ouro: https://linked.art/example/event/early_roman/1
(import std/base)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure period #record (#string slug #string label)
  (:id (example (+ "event/" slug)) :type "Period" :_label label))

(graph event-early-roman-1
  (-> (period "early_roman/1" "Early Roman Empire (31 BCE - 193 CE)")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (array (base/name vocab/primary-name "Early Roman Empire")))
      (with :part_of       (array (period "roman" "Roman Empire")))))
