;; linked.art's example, written in Ouro: https://linked.art/example/visual/spring/2
(import std/base)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure visual #record (#string slug #string label)
  (:id (example (+ "visual/" slug)) :type "VisualItem" :_label label))

;; What a painting is about, rather than what it shows: spring, the season
(graph visual-spring-2
  (-> (visual "spring/2" "Visual Content of Spring")
      (with :context "https://linked.art/ns/v1/linked-art.json")
      (with :about   (array (base/aat "300133097" "Spring (season)")))))
