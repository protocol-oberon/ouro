;; linked.art's example, written in Ouro: https://linked.art/example/group/14thc_italian/1
(import std/base)
(import std/time)
(import std/vocab)

(define/procedure example ⊢ uri (<path ⊢ string>)
  (+ "https://linked.art/example/" path))

(define/procedure group ⊢ record (<slug ⊢ string> <label ⊢ string>)
  (:id (example (+ "group/" slug)) :type "Group" :_label label))

;; An unidentified group, known by what its members have in common: born in Italy in the
;; 14th century. linked.art ends the century at midnight, not at its last second, so the span
;; is written out; and its TGN id is https, so Italy is written out too.
(document group-14thc-italian-1
  (-> (group "14thc_italian/1" "14th c italians")
      (with :context                "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by          (array (base/name vocab/primary-name "Unidentified 14th Century Italian")))
      (with :members_exemplified_by ((:type "Person"
                                      :born (:type          "Birth"
                                             :timespan      (time/span <"1300-01-01T00:00:00Z" ⊢ date> <"1399-12-31T00:00:00Z" ⊢ date>)
                                             :took_place_at ((:id     <"https://vocab.getty.edu/tgn/1000080" ⊢ uri>
                                                              :type   "Place"
                                                              :_label "Italy"))))))))
