;; linked.art's example, written in Ouro: https://linked.art/example/object/coppa/1
(import std/base)
(import std/vocab)

(define/procedure example #uri (#string path)
  (+ "https://linked.art/example/" path))

(define/procedure object #record (#string slug #string label)
  (:id (example (+ "object/" slug)) :type "HumanMadeObject" :_label label))

;; An object by an unknown maker, known only as a group: an unidentified Italian workshop
(document object-coppa-1
  (-> (object "coppa/1" "Coppa Amatoria")
      (with :context       "https://linked.art/ns/v1/linked-art.json")
      (with :identified_by (array (base/name vocab/primary-name "Coppa Amatoria")))
      (with :produced_by   (:type           "Production"
                            :carried_out_by ((:id (example "group/unknown_italian") :type "Group" :_label "Unidentified Italian"))))))
