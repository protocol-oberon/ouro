cabal-version:      3.0
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'ouro' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               ouro

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.7.0.1

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            BSD-3-Clause

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             ShilohAlleyne

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         ShilohAlleyne@gmail.com

-- A copyright notice.
-- copyright:
category:           Distribution
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- The bundled modules, embedded in the compiler when it is built.
extra-source-files: lib/**/*.ouro

common warnings
    -- -Wall, and what it leaves out: code a coming GHC will break, conversions to the type a
    -- value already has, constraints a signature asks for and does not use, and record updates
    -- that fail at run time on another constructor
    ghc-options: -Wall -Wcompat -Widentities -Wredundant-constraints -Wincomplete-record-updates

library
    -- Import common warning flags.
    import:           warnings

    -- Modules exported by the library.
    exposed-modules:
        Data.Ouro
        Data.Ouro.Build
        Data.Ouro.Error.Diagnostics
        Data.Ouro.Error.Linter
        Data.Ouro.Error.Types
        Data.Ouro.Internal.Compiler
        Data.Ouro.Internal.Expr
        Data.Ouro.Internal.Kinds
        Data.Ouro.Internal.Schema
        Data.Ouro.Internal.Source
        Data.Ouro.Internal.Uri
        Data.Ouro.Internal.Utils
        Data.Ouro.Json.Parser
        Data.Ouro.Json.Serializer
        Data.Ouro.Lisp.Analysis
        Data.Ouro.Lisp.Analysis.Forms
        Data.Ouro.Lisp.Canon
        Data.Ouro.Lisp.Canon.Adjoin
        Data.Ouro.Lisp.Canon.Alternatives
        Data.Ouro.Lisp.Canon.Bindings
        Data.Ouro.Lisp.Canon.Connectives
        Data.Ouro.Lisp.Canon.Context
        Data.Ouro.Lisp.Canon.Guards
        Data.Ouro.Lisp.Canon.Infix
        Data.Ouro.Lisp.Canon.Placeholders
        Data.Ouro.Lisp.Canon.Threading
        Data.Ouro.Lisp.Canon.Thru
        Data.Ouro.Lisp.Canon.Traverse
        Data.Ouro.Lisp.Canon.Typing
        Data.Ouro.Lisp.Canon.With
        Data.Ouro.Lisp.Eval.Builtins
        Data.Ouro.Lisp.Eval.Engine
        Data.Ouro.Lisp.Eval.Pattern
        Data.Ouro.Lisp.Eval.Schema
        Data.Ouro.Lisp.Eval.Scope
        Data.Ouro.Lisp.Eval.Structural
        Data.Ouro.Lisp.Eval.Types
        Data.Ouro.Lisp.Function
        Data.Ouro.Lisp.Lexer
        Data.Ouro.Lisp.Module.Bundled
        Data.Ouro.Lisp.Module.Loader
        Data.Ouro.Lisp.Module.Types
        Data.Ouro.Lisp.Parser
        Data.Ouro.Lisp.Surface
        Data.Ouro.Lisp.Tokens

    -- LANGUAGE extensions used by modules in this package.
    default-extensions:
        LambdaCase,
        OverloadedStrings,
        ViewPatterns


    -- Other library packages from which modules are imported.
    build-depends:
        base          ^>= 4.20.2.0,
        bytestring    ^>= 0.12,
        containers    ^>=0.7,
        file-embed    ^>= 0.0.16,
        megaparsec     >= 9.2 && < 10.0,
        microlens-platform ^>= 0.4.3,
        microlens     ^>= 0.5.0,
        microlens-mtl ^>= 0.2.1.0,
        microlens-th  ^>= 0.4.3.18,
        modern-uri    ^>= 0.3.6.1,
        monad-validate ^>= 1.3.0.0,
        mtl           ^>= 2.3.1,
        scientific    ^>= 0.3.8.1,
        text           >= 2.0,
        time          ^>= 1.12.2,
        vector        ^>= 0.13.2.0,

    -- Directories containing source files.
    hs-source-dirs:   src

    -- Base language which the package is written in.
    default-language: GHC2021

-- The command line: the project (its files and folders), the arguments, and the printed
-- diagnostics. Internal, so the tests can reach it; the compiler itself is the ouro library.
library ouro-cli
    -- Import common warning flags.
    import:           warnings

    -- Modules exported by the library.
    exposed-modules:
        CLI.Parser
        CLI.Printer
        CLI.Project
        CLI.Runner
        CLI.Source
        CLI.Types

    -- The package's version, for ouro --version
    other-modules:
        Paths_ouro
    autogen-modules:
        Paths_ouro

    -- LANGUAGE extensions used by modules in this package.
    default-extensions:
        LambdaCase,
        OverloadedStrings

    -- Other library packages from which modules are imported.
    build-depends:
        base                        ^>=4.20.2.0,
        bytestring                  ^>= 0.12,
        containers                  ^>= 0.7,
        directory                   ^>= 1.3,
        filepath                    ^>=1.5.4.0,
        megaparsec                   >= 9.2 && < 10.0,
        microlens-platform          ^>= 0.4.3,
        monad-validate              ^>= 1.3.0.0,
        mtl                         ^>= 2.3.1,
        optparse-applicative        ^>= 0.19,
        prettyprinter                >= 1.7.0,
        prettyprinter-ansi-terminal  >= 1.1.2,
        text                        ^>=2.1.3,
        ouro

    -- Directories containing source files.
    hs-source-dirs:   cli

    -- Base language which the package is written in.
    default-language: GHC2021

executable ouro
    -- Import common warning flags.
    import:           warnings

    -- .hs or .lhs file containing the Main module.
    main-is:          Main.hs

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:
    default-extensions:
        LambdaCase,
        OverloadedStrings


    -- Other library packages from which modules are imported.
    build-depends:
        base                        ^>=4.20.2.0,
        ouro-cli

    -- The console's code page is set to UTF-8 while Ouro runs on Windows
    if os(windows)
        build-depends:
            Win32                   ^>= 2.14

    -- Directories containing source files.
    hs-source-dirs:   app

    -- Base language which the package is written in.
    default-language: GHC2021

-- The compiler's tests: the library alone, with nothing of the command line
test-suite ouro-test
    -- Import common warning flags.
    import:           warnings

    -- Base language which the package is written in.
    default-language: GHC2021

    -- Modules included in this executable, other than Main.
    other-modules:
        Utils
        Ouro.AatTest
        Ouro.AnalysisTest
        Ouro.BuildTest
        Ouro.StructuralTest
        Ouro.EvaluationTest
        Ouro.FixtureTest
        Ouro.FunctionTest
        Ouro.ImportTest
        Ouro.LanguageTest
        Ouro.LetTest
        Ouro.ScopingTest
        Ouro.StdTest

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:
    default-extensions:
        LambdaCase,
        OverloadedStrings

    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0

    -- Directories containing source files.
    hs-source-dirs:   test

    -- The entrypoint to the test suite.
    main-is:          Main.hs

    -- Test dependencies.
    build-depends:
        base       ^>= 4.20.2.0,
        bytestring ^>= 0.12,
        containers ^>= 0.7,
        directory  ^>= 1.3,
        filepath   ^>= 1.5,
        hedgehog    >= 1.4,
        megaparsec  >= 9.2 && < 10.0,
        modern-uri ^>= 0.3.6.1,
        mtl        ^>= 2.3.1,
        text        >= 2.0,
        ouro

    -- The console's code page is set to UTF-8 while the tests run on Windows
    if os(windows)
        build-depends:
            Win32  ^>= 2.14

-- The command line's tests: its project code (ouro-cli) tested from inside, and ouro itself
-- run as a user runs it. Shares the compiler suite's Utils.
test-suite ouro-cli-test
    -- Import common warning flags.
    import:           warnings

    -- Base language which the package is written in.
    default-language: GHC2021

    -- Modules included in this executable, other than Main.
    other-modules:
        Utils
        Ouro.Cli.CommandTest
        Ouro.Cli.MessageTest
        Ouro.Cli.ProjectTest

    -- LANGUAGE extensions used by modules in this package.
    default-extensions:
        LambdaCase,
        OverloadedStrings

    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0

    -- Directories containing source files: its own, and test/ for Utils
    hs-source-dirs:   test-cli test

    -- The entrypoint to the test suite.
    main-is:          CliMain.hs

    -- Test dependencies.
    build-depends:
        base       ^>= 4.20.2.0,
        bytestring ^>= 0.12,
        containers ^>= 0.7,
        directory  ^>= 1.3,
        filepath   ^>= 1.5,
        hedgehog    >= 1.4,
        megaparsec  >= 9.2 && < 10.0,
        process    ^>= 1.6,
        text        >= 2.0,
        ouro,
        ouro-cli

    -- The CLI's tests run ouro itself, which this puts on the PATH
    build-tool-depends:
        ouro:ouro

    -- The console's code page is set to UTF-8 while the tests run on Windows
    if os(windows)
        build-depends:
            Win32  ^>= 2.14

-- The compiler's benchmarks: programs compiled in memory, from source to JSON, with
-- tasty-bench. Run from the package's folder, which holds the fixtures: cabal bench.
benchmark ouro-bench
    -- Import common warning flags.
    import:           warnings

    -- Base language which the package is written in.
    default-language: GHC2021

    -- LANGUAGE extensions used by modules in this package.
    default-extensions:
        LambdaCase,
        OverloadedStrings

    type:             exitcode-stdio-1.0
    hs-source-dirs:   bench
    main-is:          Main.hs

    build-depends:
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12,
        directory   ^>= 1.3,
        filepath    ^>= 1.5,
        text         >= 2.0,
        tasty-bench  >= 0.4 && < 0.6,
        ouro

    -- A larger allocation area steadies the timings, as tasty-bench advises
    ghc-options:      -rtsopts "-with-rtsopts=-A32m"
